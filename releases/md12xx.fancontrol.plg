<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/include/ipmi.php">
<INLINE>
<![CDATA[
<?php
declare(strict_types=1);
require_once __DIR__ . '/curves.php';

// Local chassis control only. No BMC passwords, network transports or arbitrary raw commands.
const COOLING_IPMI_CONFIG = '/boot/config/plugins/md12xx.fancontrol/ipmi.json';
const COOLING_IPMI_RUNTIME = '/var/run/md12xx.fancontrol';
const COOLING_IPMI_TOOL = '/usr/local/emhttp/plugins/md12xx.fancontrol/bin/ipmitool.bin';
const COOLING_IPMI_LEASE = '/boot/config/plugins/md12xx.fancontrol/ipmi-owned.json';
function cooling_ipmi_host_id(): string {
    $uuid = strtolower(trim((string) @file_get_contents('/sys/class/dmi/id/product_uuid')));
    if (!preg_match('/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/', $uuid) || preg_match('/^(?:0+|f+)$/', str_replace('-', '', $uuid))) return '';
    return hash('sha256', $uuid);
}

function cooling_ipmi_read(string $path): array {
    $data = json_decode((string) @file_get_contents($path), true);
    return is_array($data) ? $data : [];
}
function cooling_ipmi_store(string $path, array $data): void {
    $temp = $path . '.tmp.' . getmypid();
    if (file_put_contents($temp, json_encode($data, JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT), LOCK_EX) === false) throw new RuntimeException('Cannot save cooling state');
    chmod($temp, 0600);
    if (!rename($temp, $path)) { @unlink($temp); throw new RuntimeException('Cannot activate cooling state'); }
}
function cooling_ipmi_config(array $input): array {
    $mode = $input['mode'] ?? 'firmware';
    if (!in_array($mode, ['firmware', 'auto', 'manual'], true)) throw new InvalidArgumentException('Invalid IPMI control mode');
    $speed = filter_var($input['manualSpeed'] ?? 60, FILTER_VALIDATE_INT);
    if ($speed === false || $speed < 20 || $speed > 100 || $speed % 10 !== 0) throw new InvalidArgumentException('Manual speed must be 20–100%, in steps of 10');
    if (isset($input['enabled']) && !is_bool($input['enabled'])) throw new InvalidArgumentException('Invalid enable setting');
    $curveMode = $input['curveMode'] ?? 'global';
    if (!in_array($curveMode, ['global', 'individual'], true)) throw new InvalidArgumentException('Curve source must be Global or Individual');
    return ['enabled' => $input['enabled'] ?? false, 'mode' => $mode, 'manualSpeed' => $speed,
        'curveMode' => $curveMode, 'curve' => cooling_validate_curve($input['curve'] ?? cooling_default_curve(), 15)];
}
function cooling_ipmi_profile(string $vendor, string $model): bool {
    return trim($vendor) === 'Dell Inc.' && in_array(trim($model), ['PowerEdge R730', 'PowerEdge R730xd'], true);
}
function cooling_ipmi_cpu_count(string $root = '/sys/devices/system/cpu'): int {
    $packages = [];
    foreach (glob($root . '/cpu[0-9]*/topology/physical_package_id') ?: [] as $path) {
        $id = trim((string) @file_get_contents($path));
        if (ctype_digit($id)) $packages[$id] = true;
    }
    return count($packages);
}
function cooling_ipmi_run(array $args): array {
    $allowed = $args === ['sdr', 'elist', 'all'] || $args === ['mc', 'info']
        || $args === ['raw', '0x30', '0x30', '0x01', '0x01'] || $args === ['raw', '0x30', '0x30', '0x01', '0x00'];
    if (count($args) === 6 && array_slice($args, 0, 5) === ['raw', '0x30', '0x30', '0x02', '0xff'] && preg_match('/^0x[0-9a-f]{2}$/', $args[5])) {
        $speed = hexdec(substr($args[5], 2));
        $allowed = $speed >= 15 && $speed <= 100;
    }
    if (!$allowed) throw new InvalidArgumentException('Unsupported local IPMI operation');
    $pipes = [];
    $process = proc_open(array_merge(['/usr/bin/timeout', '15', COOLING_IPMI_TOOL, '-I', 'open'], $args), [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
    if (!is_resource($process)) return ['code' => 1, 'output' => 'IPMI tool could not start'];
    fclose($pipes[0]);
    // SDR output is bounded by the local BMC's sensor inventory; both pipes are drained concurrently.
    stream_set_blocking($pipes[1], false); stream_set_blocking($pipes[2], false);
    $out = '';
    do {
        foreach ([1, 2] as $n) $out .= stream_get_contents($pipes[$n]);
        $status = proc_get_status($process);
        if ($status['running']) usleep(10000);
    } while ($status['running']);
    foreach ([1, 2] as $n) { $out .= stream_get_contents($pipes[$n]); fclose($pipes[$n]); }
    $closed = proc_close($process);
    return ['code' => $status['exitcode'] >= 0 ? $status['exitcode'] : $closed, 'output' => substr($out, 0, 262144)];
}
function cooling_ipmi_sensors(string $output, int $expectedCpus): array {
    $cpus = []; $fans = []; $inlet = null; $bad = [];
    foreach (preg_split('/\R/', $output) as $line) {
        $parts = array_map('trim', explode('|', $line));
        if (count($parts) < 5) continue;
        [$name, , $status, $entity, $reading] = $parts;
        $cpu = preg_match('/^3\./', $entity) === 1 && preg_match('/temp/i', $name);
        $fan = preg_match('/^fan\s*\d+/i', $name) === 1;
        $isInlet = preg_match('/inlet.*temp/i', $name) === 1;
        if (!$cpu && !$fan && !$isInlet) continue;
        $numeric = preg_match('/^(-?\d+(?:\.\d+)?)\s+(RPM|degrees C)$/i', $reading, $match) === 1;
        if ($status !== 'ok' || !$numeric) { $bad[] = $name; continue; }
        $value = (float) $match[1];
        if ($cpu && strcasecmp($match[2], 'degrees C') === 0) {
            if (array_key_exists($entity, $cpus) || $value <= 0 || $value > 120) $bad[] = $name;
            $cpus[$entity] = $value;
        }
        if ($isInlet && strcasecmp($match[2], 'degrees C') === 0) $inlet = $value;
        if ($fan && strcasecmp($match[2], 'RPM') === 0) {
            if (array_key_exists($name, $fans) || $value <= 0) $bad[] = $name;
            $fans[$name] = $value;
        }
    }
    $healthy = $expectedCpus > 0 && count($cpus) === $expectedCpus && count($fans) >= 6 && $inlet !== null && $inlet > -10 && $inlet < 80 && !$bad;
    return ['healthy' => $healthy, 'cpuTemperaturesC' => array_values($cpus), 'cpuMaxC' => $cpus ? max($cpus) : null,
        'inletC' => $inlet, 'fanRpms' => array_values($fans), 'averageRpm' => $fans ? (int) round(array_sum($fans) / count($fans)) : null,
        'message' => $healthy ? '' : 'Complete healthy CPU, inlet and six-fan telemetry is required'];
}
function cooling_ipmi_target(array $config, array $sensors): array {
    if (!$config['enabled'] || $config['mode'] === 'firmware') return ['mode' => 'firmware', 'percent' => null, 'reason' => 'iDRAC automatic control'];
    if (!$sensors['healthy']) return ['mode' => 'firmware', 'percent' => null, 'reason' => 'Sensor fault: returning control to iDRAC'];
    if ($sensors['cpuMaxC'] >= 70 || $sensors['inletC'] >= 35) return ['mode' => 'firmware', 'percent' => null, 'reason' => 'Thermal limit: returning control to iDRAC'];
    $speed = $config['mode'] === 'manual' ? $config['manualSpeed'] : 20;
    if ($config['mode'] === 'auto') $speed = cooling_curve_speed($config['effectiveCurve'] ?? $config['curve'], (float) $sensors['cpuMaxC']);
    return ['mode' => $config['mode'], 'percent' => $speed, 'reason' => $config['mode'] === 'manual' ? 'Manual target with thermal guard' : 'CPU/inlet temperature curve'];
}
function cooling_ipmi_restore(callable $run, string $lease): bool {
    if (!is_file($lease)) return true;
    if (cooling_ipmi_host_id() === '' || (cooling_ipmi_read($lease)['host'] ?? '') !== cooling_ipmi_host_id()) return false;
    $result = $run(['raw', '0x30', '0x30', '0x01', '0x01']);
    if ($result['code'] !== 0) return false;
    return unlink($lease);
}
function cooling_ipmi_apply(array $target, callable $run, string $lease): array {
    if ($target['mode'] === 'firmware') {
        $ok = cooling_ipmi_restore($run, $lease);
        return ['ok' => $ok, 'mode' => $ok ? 'firmware' : 'unknown', 'message' => $ok ? $target['reason'] : 'iDRAC restoration failed; manual recovery required'];
    }
    // Record ownership before entering manual mode so a crash can always trigger recovery.
    if (cooling_ipmi_host_id() === '') return ['ok' => false, 'mode' => 'unknown', 'message' => 'A valid local chassis identity is required'];
    if (!is_file($lease)) cooling_ipmi_store($lease, ['owned' => true, 'host' => cooling_ipmi_host_id(), 'updatedAt' => time()]);
    if ((cooling_ipmi_read($lease)['host'] ?? '') !== cooling_ipmi_host_id()) return ['ok' => false, 'mode' => 'unknown', 'message' => 'Saved cooling ownership belongs to another chassis; review required'];
    $mode = $run(['raw', '0x30', '0x30', '0x01', '0x00']);
    $speed = $mode['code'] === 0 ? $run(['raw', '0x30', '0x30', '0x02', '0xff', sprintf('0x%02x', $target['percent'])]) : ['code' => 1];
    if ($speed['code'] !== 0) {
        $restored = cooling_ipmi_restore($run, $lease);
        return ['ok' => false, 'mode' => $restored ? 'firmware' : 'unknown', 'message' => $restored ? 'Fan command failed; returned to iDRAC' : 'Fan command and iDRAC restoration failed; manual recovery required'];
    }
    return ['ok' => true, 'mode' => $target['mode'], 'message' => 'Command acknowledged; RPM telemetry is shown separately'];
}
function cooling_ipmi_capability(): array {
    $vendor = trim((string) @file_get_contents('/sys/class/dmi/id/sys_vendor'));
    $model = trim((string) @file_get_contents('/sys/class/dmi/id/product_name'));
    $supported = cooling_ipmi_profile($vendor, $model);
    return ['supported' => $supported, 'available' => $supported && cooling_ipmi_host_id() !== '' && is_executable(COOLING_IPMI_TOOL) && (file_exists('/dev/ipmi0') || file_exists('/dev/ipmi/0')),
        'model' => $model, 'cpuCount' => cooling_ipmi_cpu_count(), 'message' => $supported ? 'Local IPMI; no network credentials required' : 'IPMI control currently supports Dell PowerEdge R730/R730xd only'];
}
function cooling_ipmi_public(): array {
    $state = cooling_ipmi_read(COOLING_IPMI_RUNTIME . '/ipmi-status.json');
    $capability = cooling_ipmi_capability();
    $global = cooling_validate_curve(cooling_ipmi_read('/boot/config/plugins/md12xx.fancontrol/config.json')['curve'] ?? cooling_default_curve());
    return array_merge($state, $capability, ['message' => $state['message'] ?? $capability['message'], 'capabilityMessage' => $capability['message'], 'config' => cooling_ipmi_config(cooling_ipmi_read(COOLING_IPMI_CONFIG)), 'globalCurve' => $global,
        'stale' => !isset($state['generatedAt']) || time() - (int) $state['generatedAt'] > 40]);
}

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/include/quiet.php">
<INLINE>
<![CDATA[
<?php
declare(strict_types=1);
require_once __DIR__ . '/common.php';
if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
try {
    $config = md12xx_validate_config(md12xx_read_config());
    $disks = md12xx_read_disk_state('/var/local/emhttp/disks.ini');
    $policy = md12xx_quiet_temperature_policy($config, $disks);
    $action = $argv[1] ?? '';
    if ($action === 'restore-speed') { echo $policy['restoreSpeed']; exit; }
    if (!$policy['safe'] || md12xx_competing_controllers($config)) throw new RuntimeException('Quiet recovery is unsafe or another writer is active');
    if ($action === 'temperatures') exit;
    if ($action !== 'baseline') throw new RuntimeException('Unknown recovery check');
    $candidates = [];
    foreach (md12xx_discover_ses() as $candidate) {
        if (empty($candidate['supportedCandidate'])) continue;
        $lines = []; $exitCode = 1;
        exec('timeout 3 sg_ses -p es ' . escapeshellarg($candidate['device']) . ' 2>/dev/null', $lines, $exitCode);
        if ($exitCode !== 0) throw new RuntimeException('Baseline telemetry unavailable');
        if (preg_match('/\b(?:Fail|CRIT|UNRECOV)=1\b/', implode("\n", $lines))) throw new RuntimeException('Enclosure reports a hardware fault; quiet recovery is blocked');
        $telemetry = md12xx_parse_fan_telemetry(implode("\n", $lines));
        if ($telemetry['state'] !== 'normal') throw new RuntimeException($telemetry['message']);
        $rpms = $telemetry['fanRpms'];
        $candidate['fanCount'] = count($rpms);
        $candidate['averageRpm'] = $rpms ? (int) round(array_sum($rpms) / count($rpms)) : 0;
        $candidates[] = $candidate;
    }
    if (!md12xx_quiet_baseline_valid($config, $candidates)) throw new RuntimeException('Quiet recovery requires every shelf at its proven 20% baseline with exact disk mapping');
} catch (Throwable $error) { fwrite(STDERR, $error->getMessage() . "\n"); exit(1); }

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/include/safety.php">
<INLINE>
<![CDATA[
<?php
declare(strict_types=1);

// Parse individual Cooling elements, never the SES overall/aggregate descriptor.
function md12xx_parse_fan_telemetry(string $output): array
{
    $values = [];
    $faults = [];
    if (preg_match_all('/Element type:\s*Cooling\b(.*?)(?=\n\s*Element type:|\z)/is', $output, $sections)) {
        foreach ($sections[1] as $section) {
            preg_match_all('/^\s*element\s+\d+\s+descriptor:(.*?)(?=^\s*(?:element\s+\d+\s+descriptor:|Overall descriptor:)|\z)/ims', $section, $elements);
            foreach ($elements[1] as $element) {
                if (!preg_match('/Actual\s+speed\s*=\s*(\d+)\s*rpm/i', $element, $speed)) {
                    $faults[] = 'Fan speed is missing';
                    continue;
                }
                $values[] = (int) $speed[1];
                if ((int) $speed[1] <= 0 || preg_match('/\b(?:Fail|Disabled|Predicted failure|CRIT|UNRECOV)\s*=\s*1\b/i', $element)
                    || (preg_match('/\bstatus:\s*([^\r\n]+)/i', $element, $status) && trim($status[1]) !== 'OK')) {
                    $faults[] = 'Cooling element reports a stopped, failed, disabled, or unhealthy fan';
                }
            }
        }
    }
    if (count($values) !== 4) $faults[] = 'Expected four individual MD12xx fan readings';
    return [
        'state' => $faults ? 'fault' : 'normal',
        'averageRpm' => $values ? (int) round(array_sum($values) / count($values)) : null,
        'fanCount' => count($values), 'fanRpms' => $values,
        'message' => implode('; ', array_unique($faults)),
    ];
}

// Before pairing is proven, monitor disks mapped to every candidate enclosure.
// Do not trust a stale manual shelf assignment during identification.
function md12xx_commission_temperature_policy(array $config, array $disks): array
{
    $curves = [$config['curve']];
    foreach ($config['shelves'] ?? [] as $shelf) if (($shelf['curveMode'] ?? 'global') === 'individual') $curves[] = $shelf['curve'];
    $failureSpeed = max((int) $config['sensorFailureSpeed'], ...array_map(static fn(array $curve): int => max(array_column($curve, 'speed')), $curves));
    $safe = count($disks) > 0;
    $required = 20;
    $active = 0;
    foreach ($disks as $disk) {
        $asleep = in_array(strtolower(trim((string) ($disk['spundown'] ?? ''))), ['1', 'yes', 'true', 'on'], true)
            || str_contains(strtolower((string) ($disk['color'] ?? '')), 'blink');
        if ($asleep) continue;
        $active++;
        $raw = $disk['temp'] ?? null;
        if (!is_numeric($raw) || (float) $raw <= 0) { $safe = false; $required = max($required, $failureSpeed); continue; }
        $speed = 20;
        foreach ($curves as $curve) {
            $speed = max($speed, (int) $curve[0]['speed']);
            foreach ($curve as $step) if ((float) $raw >= $step['temperatureC']) $speed = max($speed, (int) $step['speed']);
        }
        $required = max($required, $speed);
        if ((float) $raw >= 35 || $speed > 20) $safe = false;
    }
    if (!$disks) $required = max($required, $failureSpeed);
    // The current configuration may be manual, but commissioning must not
    // restore below its saved manual target if the test is interrupted.
    if (($config['mode'] ?? '') === 'manual') $required = max($required, (int) $config['manualSpeed']);
    return ['safe' => $safe && $required === 20, 'restoreSpeed' => $required, 'activeDisks' => $active];
}

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/include/watchdog-health.php">
<INLINE>
<![CDATA[
<?php
declare(strict_types=1);
if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
// Read-only liveness assessment. Never kill a hardware writer based on this.
$state = json_decode((string) @file_get_contents($argv[1] ?? ''), true);
$started = (int) ($argv[2] ?? time());
$now = (int) ($argv[3] ?? time());
$generated = (int) ($state['generatedAt'] ?? 0);
$budget = max(60, min(300, (int) ($state['controller']['pollSeconds'] ?? 5)) * 3 + 30);
if ($generated < $started || $generated > $now + 5 || $now - $generated > $budget) {
    echo $now - $started < $budget ? 'recovering' : 'fault';
} elseif (($state['controller']['state'] ?? '') === 'fault') {
    echo 'fault';
} else {
    echo 'normal';
}

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/MD12xxFanControl.page">
<INLINE>
<![CDATA[
Menu="Utilities"
Title="WAZ Cooling Control"
Type="xmenu"
Icon="icon-disks"
Tag="icon-disk"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'7.3.2','>=')"

---

<?php
$pluginRoot = '/usr/local/emhttp/plugins/md12xx.fancontrol';
require_once $pluginRoot . '/include/common.php';
require_once $pluginRoot . '/include/ipmi.php';
$config = md12xx_read_config();
$webRoot = '/plugins/md12xx.fancontrol';
$cssVersion = @filemtime($pluginRoot . '/assets/css/settings.css') ?: 0;
$jsVersion = @filemtime($pluginRoot . '/assets/js/settings.js') ?: 0;
?>
<link rel="stylesheet" href="<?=$webRoot?>/assets/css/settings.css?v=<?=$cssVersion?>">

<section class="md12xx-page">
  <header class="md12xx-hero"><div><h2>WAZ Cooling Control</h2><p>Local chassis and disk-shelf cooling. Each controller keeps its own settings.</p></div></header>
  <label class="md12xx-inline"><input id="cooling-show-unavailable" type="checkbox"><span>Show unavailable controls</span></label>
  <section id="cooling-ipmi" class="md12xx-panel" hidden>
    <div class="md12xx-title-row"><h3>IPMI chassis fans</h3><span id="cooling-ipmi-health" class="md12xx-pill">READING</span></div>
    <p id="cooling-ipmi-description">Checking local IPMI support…</p>
    <div class="md12xx-grid">
      <label><span>Plugin control enabled</span><input id="cooling-ipmi-enabled" type="checkbox"></label>
      <label><span>Mode</span><select id="cooling-ipmi-mode"><option value="firmware">iDRAC automatic</option><option value="auto">Temperature curve</option><option value="manual">Manual with thermal guard</option></select></label>
      <label><span>Manual speed</span><select id="cooling-ipmi-speed"><option>20</option><option>30</option><option>40</option><option>50</option><option selected>60</option><option>70</option><option>80</option><option>90</option><option>100</option></select><small>Percent</small></label>
      <label><span>Fan curve</span><select id="cooling-ipmi-curve-source"><option value="global">Global</option><option value="individual">Individual</option></select><small>Uses the hottest CPU temperature; inlet protection is independent</small></label>
    </div>
    <div id="cooling-ipmi-curve" class="cooling-curve-editor" hidden></div>
    <p id="cooling-ipmi-readings">Waiting for chassis telemetry</p>
    <p id="cooling-ipmi-message" role="status"></p>
    <p>R730/R730xd only in this beta. CPU ≥70°C, inlet ≥35°C, sensor loss, or service failure returns control to iDRAC and pauses plugin control. Stop any competing chassis fan controller before enabling this one.</p>
    <button id="cooling-ipmi-save" type="button">Save chassis settings</button>
    <button id="cooling-ipmi-restore" type="button">Return to iDRAC automatic</button>
  </section>
  <div id="cooling-md12xx">
  <header class="md12xx-hero">
    <div>
      <h2>Dell MD1200 / MD1220 Fan Control</h2>
      <p>Standalone temperature-based control with independent SES fan telemetry. <span class="md12xx-version">Version 0.5.0</span></p>
    </div>
    <div class="md12xx-hero-actions">
      <button id="md12xx-help-toggle" type="button" aria-expanded="false" aria-controls="md12xx-help">Setup directions</button>
      <span id="md12xx-health" class="md12xx-pill is-loading">LOADING</span>
    </div>
  </header>

  <p class="md12xx-beta"><b>Beta:</b> verified on two MD1200 shelves. MD1220 and additional HBA/firmware reports are wanted. The plugin never uploads data automatically.</p>

  <p class="md12xx-beta"><b>Requirements:</b> a Dell PowerVault MD1200 (verified) or MD1220 (experimental), a compatible SAS HBA/controller exposing the shelf as <code>/dev/sg*</code>, <code>sg_ses</code>, and the active EMM console on a persistent <code>/dev/serial/by-id</code> path. The tested MD1200 serial path uses a Dell-compatible six-pin service/password-reset cable and an FTDI USB-to-serial adapter. MD1400, MD1420, and other shelves are unsupported.</p>

  <p id="md12xx-controller-detail" class="md12xx-controller-detail" hidden></p>

  <section id="md12xx-help" class="md12xx-panel md12xx-help" hidden>
    <h3>Safe setup</h3>
    <ol>
      <li>Keep this controller disabled and stop every other process that controls the same shelf.</li>
      <li>Connect the Dell-compatible service/password-reset cable to the active/primary EMM, then connect its FTDI USB-to-serial adapter to Unraid. Matching firmware on both EMMs is strongly recommended.</li>
      <li>Confirm Unraid can see both the shelf's persistent serial adapter and its SES enclosure before adding it.</li>
      <li>Temporarily enable <b>Test likely FTDI adapters</b>, refresh discovery, add a shelf, choose its persistent serial adapter, and save.</li>
      <li>Select <b>Identify &amp; test</b>. The app verifies the console, proves the 20% → 50% response, pairs the SES enclosure and disks, then independently proves the return to 20%.</li>
      <li>Repeat for every shelf. Confirm each shelf says <b>Commissioned: yes</b> and review its associated disks.</li>
      <li>Active connection testing turns off automatically when setup completes. Passive inventory remains available. Enable this controller only after every competing fan writer is disabled.</li>
    </ol>
    <p><b>Separate safety paths:</b> fan commands travel only through USB serial. The SAS HBA is used read-only for topology and independent SES RPM telemetry; the plugin does not configure or flash it.</p>
    <p class="md12xx-warning"><b>Recovery:</b> if a test cannot prove the final 20% state, keep every controller stopped and follow the on-screen recovery message before continuing.</p>
  </section>

  <div id="md12xx-message" class="md12xx-message" hidden></div>

  <section class="md12xx-panel">
    <h3>Controller</h3>
    <div class="md12xx-grid">
      <label><span>Controller enabled</span><input id="md12xx-enabled" type="checkbox"></label>
      <label><span>Quiet startup recovery (35%)</span><input id="md12xx-startup-recovery" type="checkbox"></label>
      <label><span>Mode</span><select id="md12xx-mode"><option value="auto">Auto</option><option value="manual">Manual</option></select></label>
      <label><span>Manual speed</span><select id="md12xx-manual"><option value="20">20%</option><option value="30">30%</option><option value="40">40%</option><option value="50">50%</option><option value="60">60%</option><option value="70">70%</option><option value="80">80%</option><option value="90">90%</option><option value="100">100%</option></select></label>
      <label><span>Telemetry interval</span><input id="md12xx-poll" type="number" min="5" max="300" step="5"><small>Seconds; 5 recommended. Saved control changes are detected immediately.</small></label>
      <label><span>Reassert interval</span><input id="md12xx-reassert" type="number" min="60" max="3600" step="30"><small>Seconds; 900 recommended</small></label>
      <label><span>Sensor-failure speed</span><input id="md12xx-failsafe" type="number" min="20" max="100" step="5"><small>50% recommended</small></label>
    </div>
    <p class="md12xx-warning"><b>Safety:</b> enabling the controller does not enable an uncommissioned shelf. Each hardware pairing must pass Identify &amp; test.</p>
  </section>

  <section class="md12xx-panel">
    <h3>Connection discovery</h3>
    <div class="md12xx-grid">
      <label><span>Test likely FTDI adapters</span><input id="md12xx-probe-ftdi" type="checkbox"><small>Optional; automatically turns off after all configured shelves pass Identify &amp; test</small></label>
      <label><span>Discovery interval</span><input id="md12xx-discovery-interval" type="number" min="60" max="3600" step="60"><small>Seconds; 300 recommended</small></label>
      <label><span>Response wait</span><input id="md12xx-response-seconds" type="number" min="1" max="10" step="1"><small>Seconds; 3 recommended</small></label>
    </div>
    <p id="md12xx-discovery-summary" class="md12xx-discovery-summary">Waiting for passive inventory…</p>
    <p class="md12xx-warning"><b>Read-only test:</b> sends only <code>_who</code> with the hardware-confirmed carriage return. It never sends a fan-speed command, runs only while this controller is disabled, and pauses whenever another fan controller is active.</p>
  </section>

  <section class="md12xx-panel">
    <div class="md12xx-title-row"><h3>Shelves</h3><button id="md12xx-add" type="button">Add shelf</button></div>
    <div id="md12xx-shelves"></div>
  </section>

  </div>
  <section class="md12xx-panel">
    <div class="md12xx-title-row">
      <h3>Global fan curve</h3>
      <label class="md12xx-point-count"><span>Number of points</span><input id="md12xx-curve-points" type="number" min="2" max="10" step="1"></label>
    </div>
    <div id="md12xx-curve" class="md12xx-curve"></div>
    <label class="md12xx-inline"><span>Downshift hysteresis</span><input id="md12xx-hysteresis" type="number" min="0" max="10" step="0.5"><em>°C</em></label>
  </section>

  <section class="md12xx-panel md12xx-support">
    <h3>Support and transparency</h3>
    <p><b>Diagnostics stay local until you choose to share them.</b> Export and inspect the redacted archive first. Files attached to an issue in this public repository are publicly accessible.</p>
    <div class="md12xx-support-actions">
      <button id="md12xx-diagnostics" type="button">Export local diagnostics</button>
      <a class="md12xx-button-link" href="https://github.com/TheIlluminate92/unraid-md12xx-fan-control/issues/new?template=bug-report.yml" target="_blank" rel="noopener noreferrer">Report issue on GitHub</a>
    </div>
    <p class="md12xx-credit"><b>Development transparency:</b> Erik Boettcher / TheIlluminate92 owns and directs the project, supplies hardware validation, and approves releases. OpenAI Codex (GPT-5) provided primary implementation, testing, documentation, packaging, and debugging assistance under that direction and review.</p>
  </section>

  <footer class="md12xx-actions">
    <button id="md12xx-refresh" type="button">Refresh discovery</button>
    <button id="md12xx-save" class="md12xx-primary" type="button">Save global curve and shelf settings</button>
  </footer>
</section>

<script>
window.MD12xxBootstrap = <?=json_encode([
    'version' => '0.5.0',
    'endpoint' => $webRoot . '/include/api.php',
    'config' => $config,
], JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT)?>;
</script>
<script src="<?=$webRoot?>/assets/js/curves.js?v=<?=@filemtime($pluginRoot . '/assets/js/curves.js') ?: 0?>"></script>
<script src="<?=$webRoot?>/assets/js/settings.js?v=<?=$jsVersion?>"></script>
<script src="<?=$webRoot?>/assets/js/ipmi.js?v=<?=@filemtime($pluginRoot . '/assets/js/ipmi.js') ?: 0?>"></script>

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/README.md">
<INLINE>
<![CDATA[
**WAZ Cooling Control** (formerly **MD12xx Fan Control**)

Local temperature-based fan control for Dell PowerVault MD1200 and MD1220 disk shelves. Newly added IPMI chassis control for Dell PowerEdge R730/R730xd includes its userspace dependencies; fan response, return to iDRAC automatic control, and idle curve operation are confirmed on a Dell R730xd running Unraid 7.3.3.

Also includes local IPMI chassis fan control for Dell PowerEdge R730/R730xd, disabled by default. Each shelf and the chassis may follow the Global curve or an Individual curve, always using its own temperature. Unavailable hardware sections are hidden unless requested. Existing MD12xx configuration and commissioning are preserved.

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/scripts/commission-job.sh">
<INLINE>
<![CDATA[
#!/bin/bash
set -u

SHELF_ID="${1:-}"
JOB_DIR="${2:-}"
MODE="${3:-automatic}"
PLUGIN_DIR="/usr/local/emhttp/plugins/md12xx.fancontrol"

if [[ ! "$SHELF_ID" =~ ^[a-z0-9][a-z0-9_-]{0,47}$ ]] || [ -z "$JOB_DIR" ]; then
  exit 64
fi

mkdir -p "$JOB_DIR"
LOG_FILE="$JOB_DIR/output.log"
EXIT_FILE="$JOB_DIR/exit-code"
STARTED_FILE="$JOB_DIR/started-at"
RESULT_DIR_FILE="$JOB_DIR/result-directory"
COMMISSION_MARKER="/var/run/md12xx.fancontrol/commissioning.active"
CHILD_PID=""

stop_child() {
  if [ -n "$CHILD_PID" ] && kill -0 "$CHILD_PID" 2>/dev/null; then
    kill -TERM "$CHILD_PID" 2>/dev/null || true
    wait "$CHILD_PID" 2>/dev/null || true
  fi
  rm -f "$COMMISSION_MARKER"
}
trap stop_child INT TERM EXIT

date +%s > "$STARTED_FILE"
rm -f "$EXIT_FILE"
rm -f "$RESULT_DIR_FILE"

MD12XX_JOB_DIR="$JOB_DIR" "$PLUGIN_DIR/scripts/commission.sh" "$SHELF_ID" "$MODE" > "$LOG_FILE" 2>&1 &
CHILD_PID=$!
wait "$CHILD_PID"
RESULT=$?
CHILD_PID=""

# A failed test is when its captures are most useful. Package the guarded
# result directory even when commission.sh exited before its normal archive
# step, so Settings can download the evidence without requiring a terminal.
if ! grep -Eq '^Results:[[:space:]]+.+\.(zip|tar\.gz)[[:space:]]*$' "$LOG_FILE" 2>/dev/null && [ -s "$RESULT_DIR_FILE" ]; then
  RESULT_DIR="$(cat "$RESULT_DIR_FILE" 2>/dev/null || true)"
  RESULT_ROOT="/boot/config/plugins/md12xx.fancontrol/commissioning"
  case "$RESULT_DIR" in
    "$RESULT_ROOT"/*-"$SHELF_ID")
      if [ -d "$RESULT_DIR" ]; then
        RESULT_NAME="$(basename "$RESULT_DIR")"
        tar -czf "$RESULT_ROOT/${RESULT_NAME}.tar.gz" -C "$RESULT_ROOT" "$RESULT_NAME"
        printf 'Results: %s\n' "$RESULT_ROOT/${RESULT_NAME}.tar.gz" >> "$LOG_FILE"
      fi
      ;;
  esac
fi

printf '%s\n' "$RESULT" > "$EXIT_FILE.tmp"
mv -f "$EXIT_FILE.tmp" "$EXIT_FILE"
trap - INT TERM EXIT
rm -f "$COMMISSION_MARKER"
exit "$RESULT"

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/scripts/commission.sh">
<INLINE>
<![CDATA[
#!/bin/bash
set -euo pipefail

PLUGIN_DIR="/usr/local/emhttp/plugins/md12xx.fancontrol"
CONFIG_FILE="/boot/config/plugins/md12xx.fancontrol/config.json"
STATE_DIR="/var/run/md12xx.fancontrol"
RESULT_ROOT="/boot/config/plugins/md12xx.fancontrol/commissioning"
COMMISSION_MARKER="$STATE_DIR/commissioning.active"
SHELF_ID="${1:-}"
MODE="${2:-automatic}"
BASELINE_WAIT_SECONDS="${MD12XX_TEST_BASELINE_SECONDS:-30}"
RESPONSE_TIMEOUT_SECONDS="${MD12XX_TEST_RESPONSE_TIMEOUT_SECONDS:-60}"
SAMPLE_INTERVAL_SECONDS="${MD12XX_TEST_SAMPLE_INTERVAL_SECONDS:-5}"
RESPONSE_SECONDS="${MD12XX_IDENTITY_WAIT_SECONDS:-3}"
SPEED_RESPONSE_SECONDS="${MD12XX_SPEED_RESPONSE_SECONDS:-4}"
RESTORE_WAIT_SECONDS="${MD12XX_RESTORE_WAIT_SECONDS:-30}"

if [ "$(id -u)" -ne 0 ]; then echo "The commissioning service requires administrator privileges." >&2; exit 1; fi
if [ -z "$SHELF_ID" ]; then echo "Usage: $0 <shelf-id>" >&2; exit 1; fi
[[ "$MODE" == automatic || "$MODE" == manual-identify || "$MODE" == startup35 ]] || { echo "Invalid identification mode." >&2; exit 1; }
for REQUIRED in jq flock fuser sg_ses stty sha1sum awk timeout php; do command -v "$REQUIRED" >/dev/null 2>&1 || { echo "$REQUIRED is required." >&2; exit 1; }; done
[ -f "$CONFIG_FILE" ] || { echo "Save the plugin configuration first." >&2; exit 1; }
[[ "$BASELINE_WAIT_SECONDS" =~ ^[1-9][0-9]*$ ]] || { echo "The commissioning baseline window must be a positive number of seconds." >&2; exit 1; }
[[ "$RESPONSE_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || { echo "The commissioning response timeout must be a positive number of seconds." >&2; exit 1; }
[[ "$SAMPLE_INTERVAL_SECONDS" =~ ^[1-9][0-9]*$ ]] || { echo "The commissioning sample interval must be a positive number of seconds." >&2; exit 1; }

HIGH_SPEED=50
if [ "$MODE" = startup35 ]; then
  HIGH_SPEED=35
  BASELINE_WAIT_SECONDS=15
  RESPONSE_TIMEOUT_SECONDS=20
  php "$PLUGIN_DIR/include/quiet.php" baseline
else
  php "$PLUGIN_DIR/include/commission-safety.php" baseline
fi

if [ "$MODE" != startup35 ] && jq -e '.enabled == true' "$CONFIG_FILE" >/dev/null; then
  echo "Disable the MD12xx controller before identifying or commissioning hardware." >&2
  exit 1
fi
if ! jq -e --arg id "$SHELF_ID" '.shelves[] | select(.id == $id)' "$CONFIG_FILE" >/dev/null; then
  echo "Unknown shelf id: $SHELF_ID" >&2
  exit 1
fi

SHELF_JSON="$(jq -c --arg id "$SHELF_ID" '.shelves[] | select(.id == $id)' "$CONFIG_FILE")"
SHELF_NAME="$(jq -r '.name' <<< "$SHELF_JSON")"
MODEL="$(jq -r '.model' <<< "$SHELF_JSON")"
PORT="$(jq -r '.serialPort' <<< "$SHELF_JSON")"
SES_ADDRESS="$(jq -r '.sesAddress' <<< "$SHELF_JSON")"
SES_CONFIGURED="$(jq -r '.sesDevice' <<< "$SHELF_JSON")"
ASSIGNMENT="$(jq -r '.diskAssignment // (if ((.disks // []) | length) > 0 then "manual" else "automatic" end)' <<< "$SHELF_JSON")"

PORT_IDENTIFIER="${PORT#/dev/serial/by-id/}"
[[ "$PORT" == /dev/serial/by-id/* && -n "$PORT_IDENTIFIER" && "$PORT_IDENTIFIER" != "." && "$PORT_IDENTIFIER" != ".." && "$PORT_IDENTIFIER" != */* && "$PORT_IDENTIFIER" != *\\* ]] || {
  echo "Select a valid persistent serial adapter and save the configuration first." >&2
  exit 1
}
[ -e "$PORT" ] || { echo "Serial adapter is missing: $PORT" >&2; exit 1; }

if [ "$(php -r 'require $argv[1]; echo count(md12xx_competing_controllers(md12xx_read_config($argv[2])));' "$PLUGIN_DIR/include/common.php" "$CONFIG_FILE")" -gt 0 ]; then
  echo "Another fan controller is active. Disable it, then retry Identify & test." >&2
  exit 1
fi

STAMP="$(date +%Y%m%d-%H%M%S)"
RESULT_DIR="$RESULT_ROOT/${STAMP}-${SHELF_ID}"
mkdir -p "$RESULT_DIR" "$STATE_DIR"
if [ -n "${MD12XX_JOB_DIR:-}" ] && [[ "$MD12XX_JOB_DIR" == "$STATE_DIR/commission-jobs/"* ]]; then
  printf '%s\n' "$RESULT_DIR" > "$MD12XX_JOB_DIR/result-directory"
fi
HASH="$(printf '%s' "$PORT" | sha1sum | cut -c1-12)"
LOCK_FILE="$STATE_DIR/serial-${HASH}.lock"
IDENTITY_CAPTURE="$RESULT_DIR/identity.txt"
if [ "$MODE" = startup35 ]; then printf 'startup35:%s\n' "$SHELF_ID" > "$COMMISSION_MARKER"; else printf '%s\n' "$SHELF_ID" > "$COMMISSION_MARKER"; fi
trap 'rm -f "$COMMISSION_MARKER"' EXIT

verify_console() {
  (
    flock -w 15 9 || { echo "Serial adapter remained locked for 15 seconds." >&2; exit 1; }
    if fuser "$(readlink -f "$PORT")" >/dev/null 2>&1; then
      echo "Serial adapter is open in another process." >&2
      exit 1
    fi
    stty -F "$PORT" 38400 raw -echo -crtscts -hupcl cs8 -cstopb -parenb min 1 time 0
    timeout "$RESPONSE_SECONDS" cat "$PORT" > "$IDENTITY_CAPTURE" &
    local READER=$!
    sleep 0.25
    exec 8>"$PORT"
    printf '_who\r' >&8
    exec 8>&-
    wait "$READER" 2>/dev/null || true
  ) 9>"$LOCK_FILE"

  local FINGERPRINTS=0
  grep -Eqi 'Host[[:space:]]+Links[[:space:]]+UP[[:space:]]*:' "$IDENTITY_CAPTURE" && FINGERPRINTS=$((FINGERPRINTS + 1))
  grep -Eqi 'Expansion[[:space:]]+Links[[:space:]]+UP[[:space:]]*:' "$IDENTITY_CAPTURE" && FINGERPRINTS=$((FINGERPRINTS + 1))
  grep -Eqi 'Drive\(s\)[[:space:]]*:' "$IDENTITY_CAPTURE" && FINGERPRINTS=$((FINGERPRINTS + 1))
  grep -Eqi 'EMM[[:space:]]*\(' "$IDENTITY_CAPTURE" && FINGERPRINTS=$((FINGERPRINTS + 1))
  grep -Eqi 'Power[[:space:]]+Supplies[[:space:]]*:' "$IDENTITY_CAPTURE" && FINGERPRINTS=$((FINGERPRINTS + 1))
  if [ "$FINGERPRINTS" -lt 4 ] || ! grep -Eqi 'I.?m[[:space:]]+primary[[:space:]]+and[[:space:]]+active' "$IDENTITY_CAPTURE"; then
    echo "The selected adapter did not prove a primary, active MD12xx console. No fan command was sent." >&2
    return 1
  fi
}

query_sas_identity() {
  local CAPTURE="$1"
  (
    flock -w 15 9 || { echo "Serial adapter remained locked for 15 seconds." >&2; exit 1; }
    if fuser "$(readlink -f "$PORT")" >/dev/null 2>&1; then
      echo "Serial adapter is open in another process." >&2; exit 1
    fi
    stty -F "$PORT" 38400 raw -echo -crtscts -hupcl cs8 -cstopb -parenb min 1 time 0
    timeout 8 cat "$PORT" > "$CAPTURE" &
    local READER=$!
    sleep 0.3
    printf 'sas_address\r' > "$PORT"
    wait "$READER" 2>/dev/null || true
  ) 9>"$LOCK_FILE"
}

send_speed() {
  local SPEED="$1" CAPTURE
  if [ "$MODE" = startup35 ] && [ "${RESTORING:-false}" != true ]; then php "$PLUGIN_DIR/include/quiet.php" temperatures || return 1; fi
  if [ "$MODE" != startup35 ] && [ "${RESTORING:-false}" != true ]; then php "$PLUGIN_DIR/include/commission-safety.php" temperatures || return 1; fi
  CAPTURE="$RESULT_DIR/speed-${SPEED}-$$-$RANDOM.txt"
  (
    flock -w 15 9 || { echo "Serial adapter remained locked for 15 seconds." >&2; exit 1; }
    if fuser "$(readlink -f "$PORT")" >/dev/null 2>&1; then
      echo "Serial adapter is open in another process." >&2
      exit 1
    fi
    stty -F "$PORT" 38400 raw -echo -crtscts -hupcl cs8 -cstopb -parenb min 1 time 0
    timeout "$SPEED_RESPONSE_SECONDS" cat "$PORT" > "$CAPTURE" &
    local READER=$!
    sleep 0.3
    exec 8>"$PORT"
    for _ in 1 2 3 4 5; do printf 'set_speed %s\r' "$SPEED" >&8; sleep 0.1; done
    exec 8>&-
    wait "$READER" 2>/dev/null || true
  ) 9>"$LOCK_FILE"
  if ! grep -Eqi "set_speed[[:space:]]+$SPEED" "$CAPTURE"; then
    echo "The console did not acknowledge set_speed $SPEED." >&2
    return 1
  fi
}

sample_device_rpm() {
  local DEVICE="$1" LABEL="$2" QUERY_TIMEOUT="${3:-10}" SAFE RAW SPEEDS COUNT AVERAGE
  SAFE="$(basename "$DEVICE")"
  RAW="$RESULT_DIR/${LABEL}-${SAFE}-ses.txt"
  timeout "$QUERY_TIMEOUT" sg_ses -p es "$DEVICE" > "$RAW" 2>&1 || return 1
  SPEEDS="$(php -r 'require $argv[1]; $v=md12xx_parse_fan_telemetry(file_get_contents($argv[2])); if ($v["state"] !== "normal") exit(1); echo implode("\n",$v["fanRpms"]);' "$PLUGIN_DIR/include/common.php" "$RAW")" || return 1
  COUNT="$(printf '%s\n' "$SPEEDS" | sed '/^$/d' | wc -l | tr -d ' ')"
  [ "$COUNT" -ge 2 ] || return 1
  AVERAGE="$(printf '%s\n' "$SPEEDS" | awk '{sum += $1; count++} END {printf "%.0f", sum / count}')"
  printf '%s\t%s\n' "$AVERAGE" "$COUNT"
}

write_stable_response_match() {
  local HISTORY="$1" BASELINE="$2" OUTPUT="$3"
  awk -f "$PLUGIN_DIR/scripts/stable-response.awk" "$BASELINE" "$HISTORY" > "$OUTPUT"
}

sample_candidates_for_window() {
  local LABEL="$1" HISTORY="$2" SUMMARY="$3" SUMMARY_MODE="$4" WINDOW_SECONDS="$5"
  local BASELINE="${6:-}" STABLE_MATCH="${7:-}"
  local STARTED_AT NOW ELAPSED REMAINING DELAY QUERY_TIMEOUT ADDRESS DEVICE SAMPLE ROW WINDOW_EXPIRED

  printf 'elapsedSeconds\taddress\tdevice\taverageRpm\tfanCount\n' > "$HISTORY"
  : > "$SUMMARY"
  STARTED_AT="$(date +%s)"
  WINDOW_EXPIRED=false

  while true; do
    NOW="$(date +%s)"
    ELAPSED=$((NOW - STARTED_AT))
    [ "$ELAPSED" -lt "$WINDOW_SECONDS" ] || break
    REMAINING=$((WINDOW_SECONDS - ELAPSED))
    DELAY="$SAMPLE_INTERVAL_SECONDS"
    [ "$DELAY" -le "$REMAINING" ] || DELAY="$REMAINING"
    sleep "$DELAY"
    if [ "$MODE" = startup35 ]; then php "$PLUGIN_DIR/include/quiet.php" temperatures || return 1; fi
    if [ "$MODE" != startup35 ]; then php "$PLUGIN_DIR/include/commission-safety.php" temperatures || return 1; fi

    while IFS=$'\t' read -r ADDRESS DEVICE; do
      NOW="$(date +%s)"
      ELAPSED=$((NOW - STARTED_AT))
      REMAINING=$((WINDOW_SECONDS - ELAPSED))
      if [ "$REMAINING" -le 0 ]; then
        WINDOW_EXPIRED=true
        break
      fi
      QUERY_TIMEOUT=10
      [ "$QUERY_TIMEOUT" -le "$REMAINING" ] || QUERY_TIMEOUT="$REMAINING"
      if SAMPLE="$(sample_device_rpm "$DEVICE" "${LABEL}-${ELAPSED}s" "$QUERY_TIMEOUT")"; then
        NOW="$(date +%s)"
        ELAPSED=$((NOW - STARTED_AT))
        printf '%s\t%s\t%s\t%s\n' "$ELAPSED" "$ADDRESS" "$DEVICE" "$SAMPLE" >> "$HISTORY"
      fi
    done < "$CANDIDATES"

    [ "$WINDOW_EXPIRED" = false ] || break

    if [ -n "$BASELINE" ] && [ -n "$STABLE_MATCH" ]; then
      write_stable_response_match "$HISTORY" "$BASELINE" "$STABLE_MATCH"
      if [ -s "$STABLE_MATCH" ]; then
        RESPONSE_STABILIZED_SECONDS="$ELAPSED"
        break
      fi
    fi
  done

  while IFS=$'\t' read -r ADDRESS DEVICE; do
    ROW="$(awk -F '\t' -v wanted="$ADDRESS" -v mode="$SUMMARY_MODE" '
      NR == 1 || $2 != wanted { next }
      mode == "last" { rpm=$4; fans=$5; found=1; next }
      !found || $4 > rpm { rpm=$4; fans=$5; found=1 }
      END { if (found) printf "%s\t%s", rpm, fans }
    ' "$HISTORY")"
    [ -n "$ROW" ] && printf '%s\t%s\t%s\n' "$ADDRESS" "$DEVICE" "$ROW" >> "$SUMMARY"
  done < "$CANDIDATES"
}

restoration_proven() {
  local LOW_RPM="$1" HIGH_RPM="$2" FINAL_RPM="$3"
  awk -v low="$LOW_RPM" -v high="$HIGH_RPM" -v final="$FINAL_RPM" 'BEGIN {
    tolerance=low*0.15;
    if (tolerance < 300) tolerance=300;
    exit !((final <= low+tolerance) && (high-final >= 250));
  }'
}

candidate_ses() {
  php -r '
    require $argv[1];
    foreach (md12xx_discover_ses() as $s) {
      if (!empty($s["supportedCandidate"])) echo $s["address"], "\t", $s["device"], "\n";
    }
  ' "$PLUGIN_DIR/include/common.php"
}

restore_safe() {
  local RESTORE_SPEED=20
  if [ "$MODE" = startup35 ]; then RESTORE_SPEED="$(php "$PLUGIN_DIR/include/quiet.php" restore-speed 2>/dev/null || echo 100)"; fi
  if [ "$MODE" != startup35 ]; then RESTORE_SPEED="$(php "$PLUGIN_DIR/include/commission-safety.php" restore-speed 2>/dev/null || echo 100)"; fi
  [[ "$RESTORE_SPEED" =~ ^[0-9]+$ ]] && [ "$RESTORE_SPEED" -ge 20 ] && [ "$RESTORE_SPEED" -le 100 ] || RESTORE_SPEED=100
  # Reaching a higher safe target aborts the 20% calibration; never certify it.
  if [ "$RESTORE_SPEED" -gt 20 ]; then THERMAL_ABORT=true; fi
  echo "Returning the selected MD12xx console to ${RESTORE_SPEED}%..."
  RESTORING=true
  if send_speed "$RESTORE_SPEED"; then RESTORING=false; return 0; fi
  RESTORING=false
  echo "WARNING: the ${RESTORE_SPEED}% restore command failed; keep other controllers stopped and restore the shelf manually." >&2
  return 1
}

restore_and_cleanup() {
  restore_safe || true
  rm -f "$COMMISSION_MARKER"
}

thermal_wait() {
  local remaining="$1"
  while [ "$remaining" -gt 0 ]; do
    sleep 1
    if [ "$MODE" = startup35 ]; then php "$PLUGIN_DIR/include/quiet.php" temperatures || return 1;
    else php "$PLUGIN_DIR/include/commission-safety.php" temperatures || return 1; fi
    remaining=$((remaining - 1))
  done
}

require_cool_restore() {
  [ "${THERMAL_ABORT:-false}" != true ] || { echo "Cooling demand rose; restored the required higher target. Commissioning aborted." >&2; return 1; }
}

echo "Verifying the selected serial console with a read-only identity query..."
verify_console
echo "Primary, active MD12xx console verified."

if [ "$MODE" = manual-identify ]; then
  # A manual ramp only identifies the physical shelf reached by this adapter.
  # It cannot certify a serial-to-SES pairing or commission control.
  rm -f "$STATE_DIR/manual-identify-${SHELF_ID}.json"
  php -r '
    require $argv[1];
    $config=md12xx_read_config($argv[2]);
    foreach ($config["shelves"] as &$shelf) {
      if ($shelf["id"] === $argv[3]) $shelf["commissioned"]=false;
    }
    unset($shelf);
    md12xx_write_config($config, $argv[2]);
  ' "$PLUGIN_DIR/include/common.php" "$CONFIG_FILE" "$SHELF_ID"
  trap restore_and_cleanup EXIT
  trap 'exit 130' INT TERM
  echo "Commanding 20% before the manual identification ramp..."
  send_speed 20
  echo "Commanding 50% for 15 seconds. Observe which physical shelf changes."
  send_speed 50
  thermal_wait 15
  restore_safe
  require_cool_restore
  jq -n --arg port "$PORT" --argjson time "$(date +%s)" '{serialPort:$port,completedAt:$time}' > "$STATE_DIR/manual-identify-${SHELF_ID}.json.tmp"
  mv -f "$STATE_DIR/manual-identify-${SHELF_ID}.json.tmp" "$STATE_DIR/manual-identify-${SHELF_ID}.json"
  trap 'rm -f "$COMMISSION_MARKER"' EXIT
  echo "Manual ramp complete. Name the physical shelf, choose its SES enclosure using mapped disks, and explicitly confirm the pairing within 10 minutes. The ramp alone does not commission the shelf."
  exit 0
fi

if [ "$MODE" != startup35 ]; then
# A shelf is never left commissioned while a new control test is in progress.
# Only telemetry-proven restoration at the end may set this back to true.
php -r '
  require $argv[1];
  $config=md12xx_read_config($argv[2]);
  foreach ($config["shelves"] as &$shelf) {
    if ($shelf["id"] === $argv[3]) $shelf["commissioned"]=false;
  }
  unset($shelf);
  md12xx_write_config($config, $argv[2]);
' "$PLUGIN_DIR/include/common.php" "$CONFIG_FILE" "$SHELF_ID"

fi

CANDIDATES="$RESULT_DIR/candidates.tsv"
candidate_ses > "$CANDIDATES"
SAS_CAPTURE="$RESULT_DIR/serial-sas-address.txt"
SAS_MATCHES="$RESULT_DIR/sas-identity-matches.tsv"
: > "$SAS_MATCHES"
echo "Checking for an exact EMM-to-SES SAS identity match..."
if query_sas_identity "$SAS_CAPTURE"; then
  SERIAL_ELI="$(sed -nE 's/.*ELI ADDRESS:[[:space:]]*([[:xdigit:]]{16}).*/\1/p' "$SAS_CAPTURE" | tr 'A-F' 'a-f' | sort -u)"
  if [[ "$SERIAL_ELI" =~ ^[0-9a-f]{16}$ ]] && [ "$SERIAL_ELI" != 0000000000000000 ]; then
    while IFS=$'\t' read -r ADDRESS DEVICE; do
      SES_CAPTURE="$RESULT_DIR/sas-$(basename "$DEVICE")-configuration.txt"
      timeout 10 sg_ses -R -p 0x01 "$DEVICE" > "$SES_CAPTURE" 2>&1 || continue
      SES_ELI="$(sed -nE 's/.*enclosure logical identifier \(hex\):[[:space:]]*([[:xdigit:]]{16}).*/\1/p' "$SES_CAPTURE" | tr 'A-F' 'a-f' | sort -u)"
      if [ "$SES_ELI" = "$SERIAL_ELI" ]; then printf '%s\t%s\n' "$ADDRESS" "$DEVICE" >> "$SAS_MATCHES"; fi
    done < "$CANDIDATES"
  fi
fi
if [ "$MODE" = startup35 ] && [ -n "${SERIAL_ELI:-}" ]; then
  EXPECTED_ELI="$(jq -r '.sesIdentity' <<< "$SHELF_JSON")"
  if [ "$SERIAL_ELI" != "$EXPECTED_ELI" ]; then
    echo "The serial identity differs from the commissioned shelf; no quiet ramp was started." >&2
    exit 1
  fi
fi
sas_pairing_fallback() {
  [ "$MODE" != startup35 ] || return 1
  [ "$(wc -l < "$SAS_MATCHES")" -eq 1 ] || return 1
  IFS=$'\t' read -r SES_ADDRESS SES_DEVICE < "$SAS_MATCHES"
  echo "RPM proof unavailable. Exact SAS identity match: selected EMM and $SES_DEVICE share enclosure logical identifier $SERIAL_ELI."
  trap restore_and_cleanup EXIT
  trap 'exit 130' INT TERM
  echo "Commanding 20%, then 50% for 15 seconds, then restoring 20%..."
  send_speed 20
  send_speed 50
  thermal_wait 15
  restore_safe
  require_cool_restore
  # Both interfaces have the same enclosure identity. SES fan RPM is not
  # claimed as live proof of the acknowledged serial speed commands.
  MAPPING_JSON="$(php -r 'require $argv[1]; echo json_encode(md12xx_ses_disk_mapping($argv[2]), JSON_UNESCAPED_SLASHES);' "$PLUGIN_DIR/include/common.php" "$SES_ADDRESS")"
  AUTO_DISKS="$(jq -c '.disks // []' <<< "$MAPPING_JSON")"
  READY=false
  if [ "$(jq -r '.state' <<< "$MAPPING_JSON")" = verified ] && [ "$(jq '(.disks // []) | length' <<< "$MAPPING_JSON")" -gt 0 ]; then
    if [ "$ASSIGNMENT" = automatic ]; then
      READY=true
    elif jq -e --argjson mapped "$AUTO_DISKS" '(.disks // []) as $chosen | ($chosen | length > 0) and ([$chosen[] | select(. as $disk | $mapped | index($disk) == null)] | length == 0)' <<< "$SHELF_JSON" >/dev/null; then
      READY=true
    fi
  fi
  php -r '
    require $argv[1];
    $config=md12xx_read_config($argv[2]);
    $automaticDisks=json_decode($argv[6], true) ?: [];
    foreach ($config["shelves"] as &$shelf) {
      if ($shelf["id"] !== $argv[3]) continue;
      $shelf["sesAddress"]=$argv[4];
      $shelf["sesDevice"]=$argv[5];
      $shelf["sesIdentity"]=md12xx_commissioned_ses_identity($argv[5], $argv[4], $shelf["model"]);
      if (($shelf["diskAssignment"] ?? "automatic") === "automatic") $shelf["disks"]=$automaticDisks;
      $shelf["calibration"]=[];
      $shelf["verificationMode"]="sas";
      $shelf["commissioned"]=$argv[7] === "true";
    }
    unset($shelf);
    $config=md12xx_disable_active_discovery_after_setup($config);
    md12xx_write_config($config, $argv[2]);
  ' "$PLUGIN_DIR/include/common.php" "$CONFIG_FILE" "$SHELF_ID" "$SES_ADDRESS" "$SES_DEVICE" "$AUTO_DISKS" "$READY"
  trap 'rm -f "$COMMISSION_MARKER"' EXIT
  echo "SAS identity pairing: PASS; 20% restoration acknowledged. SES fan RPM response remains unverified." | tee "$RESULT_DIR/result.txt"
  echo "Matched SES: $SES_ADDRESS -> $SES_DEVICE" | tee -a "$RESULT_DIR/result.txt"
  echo "Mapped Unraid disks: $(jq -r 'if length then join(", ") else "none" end' <<< "$AUTO_DISKS")" | tee -a "$RESULT_DIR/result.txt"
  if [ "$READY" = true ]; then
    echo "Identity pairing commissioned with reduced RPM verification. Review the shelf and disks before enabling control."
    exit 0
  fi
  echo "Identity matched, but no verified disk assignment was available. The shelf remains uncommissioned." >&2
  exit 1
}
if [ "$MODE" = startup35 ]; then
  echo "Quiet recovery requires a unique 35% RPM response and the saved identity; reduced-verification fallback is disabled."
else
  echo "Trying independent RPM proof first; an exact SAS identity match is available as a fallback when SES RPM stays static."
fi
# An exact serial identity outranks historical addresses, including during legacy migration.
# Automatic setup without an exact identity tests all candidates and still requires
# a unique RPM response; it never chooses a shelf by enumeration order.
if ! awk -v assignment="$ASSIGNMENT" -v address="$SES_ADDRESS" -v device="$SES_CONFIGURED" \
  -f "$PLUGIN_DIR/scripts/select-candidates.awk" "$SAS_MATCHES" "$CANDIDATES" > "$CANDIDATES.selected"; then
  echo "Multiple SES paths match the serial identity; resolve the ambiguity before commissioning." >&2
  exit 1
fi
mv "$CANDIDATES.selected" "$CANDIDATES"
[ -s "$CANDIDATES" ] || { echo "No supported MD1200/MD1220 SES enclosure is available for this test." >&2; exit 1; }

LOW="$RESULT_DIR/20-percent.tsv"
HIGH="$RESULT_DIR/${HIGH_SPEED}-percent.tsv"
LOW_HISTORY="$RESULT_DIR/20-percent-history.tsv"
HIGH_HISTORY="$RESULT_DIR/${HIGH_SPEED}-percent-history.tsv"
trap restore_and_cleanup EXIT
trap 'exit 130' INT TERM

echo "Commanding 20% and sampling every ${SAMPLE_INTERVAL_SECONDS}s for ${BASELINE_WAIT_SECONDS}s..."
send_speed 20
sample_candidates_for_window 20-percent "$LOW_HISTORY" "$LOW" last "$BASELINE_WAIT_SECONDS"
if [ ! -s "$LOW" ]; then
  echo "No valid SES fan telemetry was available for the 20% baseline." >&2
  sas_pairing_fallback
  exit 1
fi

STABLE_MATCH="$RESULT_DIR/stable-response.tsv"
RESPONSE_STABILIZED_SECONDS=""
echo "Commanding ${HIGH_SPEED}% and sampling every ${SAMPLE_INTERVAL_SECONDS}s until the response stabilizes or ${RESPONSE_TIMEOUT_SECONDS}s elapse..."
send_speed "$HIGH_SPEED"
sample_candidates_for_window "${HIGH_SPEED}-percent" "$HIGH_HISTORY" "$HIGH" maximum "$RESPONSE_TIMEOUT_SECONDS" "$LOW" "$STABLE_MATCH"

RESTORE_SENT=true
restore_safe || RESTORE_SENT=false
require_cool_restore

MATCHES="$RESULT_DIR/matches.tsv"
cp "$STABLE_MATCH" "$MATCHES"

MATCH_COUNT="$(wc -l < "$MATCHES" | tr -d ' ')"
if [ "$MATCH_COUNT" -ne 1 ]; then
  if [ "$RESTORE_SENT" = true ] && [ "$(wc -l < "$SAS_MATCHES")" -eq 1 ]; then
    sas_pairing_fallback
  fi
  echo "Identification did not find exactly one enclosure with two consecutive stable higher-RPM samples before the ${RESPONSE_TIMEOUT_SECONDS}s timeout." >&2
  echo "A 20% restore was attempted, but no unique enclosure was available for independent restoration proof." >&2
  echo "Use Manual mapping only after checking the captured results in $RESULT_DIR." >&2
  exit 1
fi

IFS=$'\t' read -r SES_ADDRESS SES_DEVICE RPM_20 RPM_HIGH DELTA PERCENT < "$MATCHES"
FIRST_RESPONSE_SECONDS="$(awk -F '\t' -v wanted="$SES_ADDRESS" -v low="$RPM_20" '
  NR == 1 || $2 != wanted { next }
  { delta=$4-low; pct=(low>0 ? delta/low*100 : 0) }
  delta >= 250 && pct >= 10 { print $1; exit }
' "$HIGH_HISTORY")"

echo "Waiting ${RESTORE_WAIT_SECONDS}s to prove the selected enclosure returned to 20%..."
thermal_wait "$RESTORE_WAIT_SECONDS"
FINAL_SAMPLE="$(sample_device_rpm "$SES_DEVICE" final-restore || true)"
FINAL_RPM="${FINAL_SAMPLE%%$'\t'*}"

if [ "$RESTORE_SENT" != true ] || [ -z "$FINAL_RPM" ] || ! restoration_proven "$RPM_20" "$RPM_HIGH" "$FINAL_RPM"; then
  echo "The first 20% restore was not proven by SES telemetry (${FINAL_RPM:-no RPM} RPM); retrying once." >&2
  restore_safe || true
  require_cool_restore
  thermal_wait "$RESTORE_WAIT_SECONDS"
  FINAL_SAMPLE="$(sample_device_rpm "$SES_DEVICE" final-restore-retry || true)"
  FINAL_RPM="${FINAL_SAMPLE%%$'\t'*}"
fi

if [ -z "$FINAL_RPM" ] || ! restoration_proven "$RPM_20" "$RPM_HIGH" "$FINAL_RPM"; then
  if [ "$(wc -l < "$SAS_MATCHES")" -eq 1 ]; then
    sas_pairing_fallback
  fi
  echo "SAFETY FAILURE: the enclosure did not prove a return to its 20% RPM range." >&2
  echo "The shelf remains uncommissioned. Keep other controllers stopped, resolve the serial connection, then select Identify & test again; every retry begins by commanding 20%." >&2
  exit 1
fi

if [ "$MODE" = startup35 ]; then
  php "$PLUGIN_DIR/include/quiet.php" temperatures
  php -r '
    require $argv[1];
    $config=md12xx_validate_config(md12xx_read_config($argv[2]));
    $original=json_decode($argv[6], true);
    $identity=md12xx_commissioned_ses_identity($argv[5], $argv[4], $original["model"]);
    if ($identity !== ($original["sesIdentity"] ?? "")) throw new RuntimeException("Quiet response did not confirm the saved enclosure identity");
    $mapping=md12xx_ses_disk_mapping($argv[4]);
    $saved=$original["disks"]; $mapped=$mapping["disks"] ?? []; sort($saved); sort($mapped);
    if (($mapping["state"] ?? "") !== "verified" || $saved !== $mapped) throw new RuntimeException("Quiet response did not confirm the commissioned disks");
    foreach ($config["shelves"] as &$shelf) {
      if ($shelf["id"] !== $argv[3]) continue;
      if ($shelf !== $original) throw new RuntimeException("Shelf configuration changed during recovery");
      $shelf["sesAddress"]=$argv[4]; $shelf["sesDevice"]=$argv[5];
    }
    unset($shelf); md12xx_write_config($config, $argv[2]);
  ' "$PLUGIN_DIR/include/common.php" "$CONFIG_FILE" "$SHELF_ID" "$SES_ADDRESS" "$SES_DEVICE" "$SHELF_JSON"
  trap 'rm -f "$COMMISSION_MARKER"' EXIT
  echo "Quiet startup recovery: PASS; unique 35% RPM response, saved identity and disks confirmed, final 20% restoration verified." | tee "$RESULT_DIR/result.txt"
  exit 0
fi

echo "Final 20% restoration: PASS ($FINAL_RPM RPM)."
# The hardware is safely back at 20%, but keep the commissioning marker until
# the verified mapping and calibration are durably saved. This prevents a
# Settings save from racing the final configuration write.
trap 'rm -f "$COMMISSION_MARKER"' EXIT
trap 'exit 130' INT TERM

MAPPING_JSON="$(php -r 'require $argv[1]; echo json_encode(md12xx_ses_disk_mapping($argv[2]), JSON_UNESCAPED_SLASHES);' "$PLUGIN_DIR/include/common.php" "$SES_ADDRESS")"
AUTO_DISKS="$(jq -c '.disks // []' <<< "$MAPPING_JSON")"
AUTO_COUNT="$(jq '(.disks // []) | length' <<< "$MAPPING_JSON")"
READY=false
if [ "$ASSIGNMENT" = "manual" ]; then
  [ "$(jq '(.disks // []) | length' <<< "$SHELF_JSON")" -gt 0 ] && READY=true
elif [ "$AUTO_COUNT" -gt 0 ]; then
  READY=true
fi

php -r '
  require $argv[1];
  $config=md12xx_read_config($argv[2]);
  $automaticDisks=json_decode($argv[6], true) ?: [];
  foreach ($config["shelves"] as &$shelf) {
    if ($shelf["id"] !== $argv[3]) continue;
    $shelf["sesAddress"]=$argv[4];
    $shelf["sesDevice"]=$argv[5];
    $shelf["sesIdentity"]=md12xx_commissioned_ses_identity($argv[5], $argv[4], $shelf["model"]);
    $assignment=$shelf["diskAssignment"] ?? (!empty($shelf["disks"]) ? "manual" : "automatic");
    if ($assignment === "automatic") $shelf["disks"]=$automaticDisks;
    $shelf["calibration"]=["rpmAt20"=>(int)$argv[8], "rpmAt50"=>(int)$argv[9]];
    $shelf["commissioned"]=$argv[7] === "true";
  }
  unset($shelf);
  $config=md12xx_disable_active_discovery_after_setup($config);
  md12xx_write_config($config, $argv[2]);
' "$PLUGIN_DIR/include/common.php" "$CONFIG_FILE" "$SHELF_ID" "$SES_ADDRESS" "$SES_DEVICE" "$AUTO_DISKS" "$READY" "$RPM_20" "$RPM_HIGH"

{
  echo "MD12xx fan control identification and commissioning"
  echo "Collected: $(date -Is)"
  echo "Shelf: $SHELF_NAME ($MODEL)"
  echo "Serial: $PORT"
  echo "Matched SES: $SES_ADDRESS -> $SES_DEVICE"
  echo "20%: $RPM_20 RPM"
  echo "50%: $RPM_HIGH RPM"
  echo "Response: PASS (delta +$DELTA RPM, $PERCENT%)"
  echo "Response first observed: ${FIRST_RESPONSE_SECONDS:-unknown}s"
  echo "Stable response confirmed: ${RESPONSE_STABILIZED_SECONDS:-unknown}s (two consecutive samples within 10% or 250 RPM; ${RESPONSE_TIMEOUT_SECONDS}s timeout)"
  echo "Disk assignment: $ASSIGNMENT"
  echo "Automatic disks: $(jq -r 'if length then join(", ") else "none" end' <<< "$AUTO_DISKS")"
  echo "Final restore: PASS ($FINAL_RPM RPM after ${RESTORE_WAIT_SECONDS}s)"
} | tee "$RESULT_DIR/result.txt"

if [ "$READY" = true ]; then
  echo "Identification and commissioning saved. The shelf may now be enabled from Settings."
else
  echo "The serial-to-SES pairing passed, but no usable disk assignment was found." >&2
  echo "The pairing was saved without commissioning. Use Manual mapping, select the shelf disks, save, and rerun this test." >&2
fi

if command -v zip >/dev/null 2>&1; then
  (cd "$RESULT_ROOT" && zip -qr "${STAMP}-${SHELF_ID}.zip" "${STAMP}-${SHELF_ID}")
  echo "Results: $RESULT_ROOT/${STAMP}-${SHELF_ID}.zip"
else
  tar -czf "$RESULT_ROOT/${STAMP}-${SHELF_ID}.tar.gz" -C "$RESULT_ROOT" "${STAMP}-${SHELF_ID}"
  echo "Results: $RESULT_ROOT/${STAMP}-${SHELF_ID}.tar.gz"
fi
[ "$READY" = true ]

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/scripts/controller-supervisor.sh">
<INLINE>
<![CDATA[
#!/bin/bash
set -u

RUNTIME_DIR="/usr/local/emhttp/plugins/md12xx.fancontrol"
STATE_DIR="/var/run/md12xx.fancontrol"
SUPERVISOR_PID_FILE="$STATE_DIR/supervisor.pid"
CONTROLLER_PID_FILE="$STATE_DIR/controller.pid"
WATCHDOG_FILE="$STATE_DIR/watchdog.json"
CONTROLLER_LOG="$STATE_DIR/controller.log"
NOTIFY_SCRIPT="/usr/local/emhttp/webGui/scripts/notify"
ALERT_STAMP_FILE="$STATE_DIR/watchdog-alert.stamp"
MAX_LOG_BYTES=65536
ALERT_INTERVAL=900

mkdir -p "$STATE_DIR"
printf '%s\n' "$$" > "$SUPERVISOR_PID_FILE"

running=true
child_pid=""
restart_count=0
consecutive_failures=0
failure_notified=false

json_message() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/[[:cntrl:]]/ /g'
}

write_watchdog() {
  local state="$1" message="$2" delay="${3:-0}" child="${4:-0}" tmp
  tmp="$WATCHDOG_FILE.tmp.$$"
  printf '{\n  "generatedAt": %s,\n  "state": "%s",\n  "message": "%s",\n  "restartCount": %s,\n  "restartDelaySeconds": %s,\n  "controllerPid": %s\n}\n' \
    "$(date +%s)" "$state" "$(json_message "$message")" "$restart_count" "$delay" "$child" > "$tmp"
  mv -f "$tmp" "$WATCHDOG_FILE"
}

notify_local() {
  local importance="$1" subject="$2" description="$3" now last=0
  now="$(date +%s)"
  [ -r "$ALERT_STAMP_FILE" ] && last="$(cat "$ALERT_STAMP_FILE" 2>/dev/null || echo 0)"
  if [ "$importance" != "normal" ] && [ $((now - last)) -lt "$ALERT_INTERVAL" ]; then
    return
  fi
  printf '%s\n' "$now" > "$ALERT_STAMP_FILE"
  if [ -x "$NOTIFY_SCRIPT" ]; then
    "$NOTIFY_SCRIPT" -e "MD12xx Fan Control" -s "$subject" -d "$description" -i "$importance" >/dev/null 2>&1 || true
  else
    logger -t md12xx.fancontrol "$subject: $description" 2>/dev/null || true
  fi
}

process_alive() {
  local pid="$1" state
  kill -0 "$pid" 2>/dev/null || return 1
  [ -r "/proc/$pid/stat" ] || return 1
  state="$(awk '{print $3}' "/proc/$pid/stat" 2>/dev/null || true)"
  [ "$state" != "Z" ]
}

trim_log() {
  local size tmp
  [ -f "$CONTROLLER_LOG" ] || return
  size="$(wc -c < "$CONTROLLER_LOG" 2>/dev/null || echo 0)"
  [ "$size" -le "$MAX_LOG_BYTES" ] && return
  tmp="$CONTROLLER_LOG.tmp.$$"
  # Keep the inode: the running child still holds this log open.
  if tail -c "$MAX_LOG_BYTES" "$CONTROLLER_LOG" > "$tmp" 2>/dev/null; then cat "$tmp" > "$CONTROLLER_LOG"; fi
  rm -f "$tmp"
}

shutdown() {
  running=false
  if [ -n "$child_pid" ] && process_alive "$child_pid"; then
    kill "$child_pid" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      process_alive "$child_pid" || break
      sleep 1
    done
  fi
}

cleanup() {
  rm -f "$SUPERVISOR_PID_FILE"
  if [ -z "$child_pid" ] || ! process_alive "$child_pid"; then
    rm -f "$CONTROLLER_PID_FILE"
  fi
  write_watchdog "stopped" "Controller supervisor stopped intentionally" 0 0
}

trap shutdown INT TERM
trap cleanup EXIT

while $running; do
  trim_log
  started_at="$(date +%s)"
  /usr/bin/php "$RUNTIME_DIR/include/controller.php" >> "$CONTROLLER_LOG" 2>&1 &
  child_pid="$!"
  printf '%s\n' "$child_pid" > "$CONTROLLER_PID_FILE"
  if [ "$restart_count" -gt 0 ]; then
    write_watchdog "recovering" "Controller restarted; monitoring recovery" 0 "$child_pid"
  else
    write_watchdog "recovering" "Waiting for fresh controller status" 0 "$child_pid"
  fi
  recovered=false
  health_state="recovering"
  current_health="recovering"

  while $running && process_alive "$child_pid"; do
    alive_for=$(( $(date +%s) - started_at ))
    if [ $((alive_for % 30)) -eq 0 ]; then trim_log; fi
    if [ $((alive_for % 5)) -eq 0 ]; then
      current_health="$(/usr/bin/php "$RUNTIME_DIR/include/watchdog-health.php" "$STATE_DIR/status.json" "$started_at" 2>/dev/null || echo fault)"
    fi
    current_health="${current_health:-recovering}"
    if [ "$current_health" = fault ]; then
      if [ "$health_state" != fault ]; then
        write_watchdog "fault" "Controller is alive but its status is faulted or stale; no automatic restart was attempted" 0 "$child_pid"
      fi
      notify_local alert "Controller requires attention" "The controller process is alive but reports a fault or has stopped publishing fresh status. Review the shelf status; the supervisor will not create a competing writer."
      failure_notified=true
      recovered=false
    fi
    if [ "$alive_for" -ge 60 ] && [ "$current_health" = normal ] && [ "$recovered" = false ]; then
      recovered=true
      consecutive_failures=0
      write_watchdog "normal" "Controller is running under supervision" 0 "$child_pid"
      if $failure_notified; then
        notify_local normal "Controller recovered" "The fan controller restarted and has remained healthy for 60 seconds."
        failure_notified=false
      fi
    fi
    health_state="$current_health"
    sleep 1
  done

  wait "$child_pid" 2>/dev/null
  exit_code="$?"
  rm -f "$CONTROLLER_PID_FILE"
  child_pid=""
  $running || break

  restart_count=$((restart_count + 1))
  consecutive_failures=$((consecutive_failures + 1))
  if [ "$consecutive_failures" -ge 5 ]; then
    delay=60
  else
    delay=$((5 << (consecutive_failures - 1)))
  fi
  write_watchdog "restarting" "Controller exited unexpectedly (exit $exit_code); restart scheduled" "$delay" 0
  notify_local alert "Controller stopped unexpectedly" "The plugin will restart the fan controller in $delay seconds. Open Settings > Utilities > MD12xx Fan Control to review status."
  failure_notified=true

  for ((remaining=delay; remaining>0; remaining--)); do
    $running || break
    sleep 1
  done
done

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/scripts/diagnose.sh">
<INLINE>
<![CDATA[
#!/bin/bash
set -euo pipefail

CONFIG_DIR="/boot/config/plugins/md12xx.fancontrol"
STATE_DIR="/var/run/md12xx.fancontrol"
RESULT_ROOT="$CONFIG_DIR/diagnostics"
STAMP="$(date +%Y%m%d-%H%M%S)"
RESULT_DIR="$RESULT_ROOT/$STAMP"
mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/diagnostics.lock"
flock -n 9 || { echo "A diagnostics export is already running." >&2; exit 1; }
printf '%s\n' "$$" > "$STATE_DIR/diagnostics.pid"
trap 'rm -f "$STATE_DIR/diagnostics.pid"' EXIT
mkdir -p "$RESULT_DIR"

{
  echo "Collected: $(date -Is)"
  echo "Unraid: $(cat /etc/unraid-version 2>/dev/null || true)"
  echo "Kernel: $(uname -rmo)"
  echo "sg_ses: $(command -v sg_ses 2>/dev/null || echo missing)"
  echo "Privacy: local archive; hostname, serial identifiers, disk names, and paths redacted"
} > "$RESULT_DIR/system.txt"

if [ -f "$CONFIG_DIR/config.json" ]; then
  jq '
    .legacyContainerNames = ((.legacyContainerNames // []) | length) |
    .shelves = ((.shelves // []) | to_entries | map(
      (.key + 1) as $index | .value |
      .name = ("Shelf " + ($index | tostring)) |
      .serialPort = (if (.serialPort // "") == "" then "" else "/dev/serial/by-id/[redacted]" end) |
      .sesAddress = (if (.sesAddress // "") == "" then "" else "[redacted]" end) |
      .sesIdentity = (if (.sesIdentity // "") == "" then "" else "[redacted]" end) |
      .sesDevice = (if (.sesDevice // "") == "" then "" else "/dev/sg[redacted]" end) |
      .disks = ((.disks // []) | to_entries | map("mapped-disk-" + ((.key + 1) | tostring)))
    ))
  ' "$CONFIG_DIR/config.json" > "$RESULT_DIR/config.redacted.json"
fi

if [ -f /var/run/md12xx.fancontrol/status.json ]; then
  jq '
    .shelves = ((.shelves // []) | to_entries | map(
      (.key + 1) as $index | .value |
      .name = ("Shelf " + ($index | tostring)) |
      del(.serialPort) |
      .sesAddress = (if (.sesAddress // "") == "" then "" else "[redacted]" end) |
      .sesIdentity = (if (.sesIdentity // "") == "" then "" else "[redacted]" end) |
      .sesDevice = (if (.sesDevice // "") == "" then "" else "/dev/sg[redacted]" end) |
      .assignedDisks = ((.assignedDisks // []) | to_entries | map("mapped-disk-" + ((.key + 1) | tostring))) |
      .missingDisks = ((.missingDisks // []) | to_entries | map("missing-disk-" + ((.key + 1) | tostring))) |
      .missingTemperatures = ((.missingTemperatures // []) | to_entries | map("unknown-temperature-" + ((.key + 1) | tostring))) |
      if has("temperatureSource") and .temperatureSource != null then .temperatureSource = "mapped-disk" else . end
    ))
  ' /var/run/md12xx.fancontrol/status.json > "$RESULT_DIR/status.redacted.json"
fi

if [ -f /var/run/md12xx.fancontrol/watchdog.json ]; then
  jq '{generatedAt, state, message, restartCount, restartDelaySeconds}' \
    /var/run/md12xx.fancontrol/watchdog.json > "$RESULT_DIR/watchdog.json"
fi

if [ -f "$STATE_DIR/ipmi-status.json" ]; then
  jq '{generatedAt, state, enabled, mode, targetPercent, cpuMaxC, inletC, fanRpms, averageRpm, healthy, message, targetReason, latched}' \
    "$STATE_DIR/ipmi-status.json" > "$RESULT_DIR/ipmi-status.redacted.json"
fi

if [ -f /var/run/md12xx.fancontrol/discovery.json ]; then
  jq '
    .serialPorts = ((.serialPorts // []) | map({
      vendorId, productId, manufacturer, product, knownFtdiCandidate,
      probeState, blueDressPrompt, md12xxResponse, primaryActive, consoleVerified, message
    })) |
    .sesDevices = ((.sesDevices // []) | map({
      vendor, model, supportedCandidate, diskMappingState,
      blockDeviceCount: ((.blockDevices // []) | length),
      diskCount: ((.disks // []) | length), diskMappingMessage
    })) |
    .disks = ((.disks // []) | map({temperatureAvailable: (.temperatureC != null)}))
  ' /var/run/md12xx.fancontrol/discovery.json > "$RESULT_DIR/discovery.redacted.json"
fi

ENCLOSURE_INDEX=0
for GENERIC in /sys/class/scsi_generic/sg*; do
  [ -e "$GENERIC/device" ] || continue
  TYPE="$(cat "$GENERIC/device/type" 2>/dev/null || true)"
  [ "$TYPE" = "13" ] || continue
  ENCLOSURE_INDEX=$((ENCLOSURE_INDEX + 1))
  SG="/dev/$(basename "$GENERIC")"
  {
    echo "Address: [redacted]"
    echo "Vendor: $(cat "$GENERIC/device/vendor" 2>/dev/null || true)"
    echo "Model: $(cat "$GENERIC/device/model" 2>/dev/null || true)"
    timeout 10 sg_ses -p es "$SG" 2>&1 || true
  } > "$RESULT_DIR/enclosure-${ENCLOSURE_INDEX}-ses.txt"
done

tar -czf "$RESULT_ROOT/${STAMP}.tar.gz" -C "$RESULT_ROOT" "$STAMP"
rm -rf -- "$RESULT_DIR"
echo "Read-only diagnostics: $RESULT_ROOT/${STAMP}.tar.gz"

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/scripts/interrogate-emm.sh">
<INLINE>
<![CDATA[
#!/bin/bash
set -euo pipefail

# Read-only console inventory. Run only with the controller disabled and no
# other process holding either service adapter. The command list is captured,
# never parsed into commands to execute.
PLUGIN_DIR="/usr/local/emhttp/plugins/md12xx.fancontrol"
CONFIG_FILE="/boot/config/plugins/md12xx.fancontrol/config.json"
STATE_DIR="/var/run/md12xx.fancontrol"
RESULT_ROOT="/boot/config/plugins/md12xx.fancontrol/diagnostics"

[ "$(id -u)" -eq 0 ] || { echo "Run as root on Unraid." >&2; exit 1; }
[ "$#" -gt 0 ] || { echo "Usage: $0 /dev/serial/by-id/<adapter> [second-adapter...]" >&2; exit 1; }
for tool in jq php flock fuser stty timeout sha1sum tar sg_ses; do
  command -v "$tool" >/dev/null || { echo "$tool is required." >&2; exit 1; }
done

[ -f "$CONFIG_FILE" ] || { echo "Plugin configuration is missing." >&2; exit 1; }
jq -e '.enabled == false' "$CONFIG_FILE" >/dev/null || { echo "Disable the MD12xx controller first." >&2; exit 1; }
[ "$(php -r 'require $argv[1]; echo count(md12xx_competing_controllers(md12xx_read_config($argv[2])));' "$PLUGIN_DIR/include/common.php" "$CONFIG_FILE")" -eq 0 ] || {
  echo "Another fan controller is active; stop it first." >&2; exit 1;
}
mkdir -p "$STATE_DIR" "$RESULT_ROOT"
exec 7>"$STATE_DIR/emm-interrogation.lock"
flock -n 7 || { echo "An EMM interrogation is already running." >&2; exit 1; }
[ ! -e "$STATE_DIR/commissioning.active" ] || { echo "Commissioning is active." >&2; exit 1; }

STAMP="$(date +%Y%m%d-%H%M%S)"
RESULT_DIR="$RESULT_ROOT/emm-${STAMP}"
mkdir -p "$RESULT_DIR"
archive="$RESULT_DIR.tar.gz"
finish() {
  local status=$?
  trap - EXIT
  tar -czf "$archive" -C "$RESULT_ROOT" "$(basename "$RESULT_DIR")" || true
  echo "Review serial identifiers before public upload: $archive"
  exit "$status"
}
trap finish EXIT
echo "Collected: $(date -Is)" > "$RESULT_DIR/manifest.txt"
echo "Commands sent: _who, _ver, devils (console command listing). No discovered commands were executed." >> "$RESULT_DIR/manifest.txt"

query() {
  local port="$1" command="$2" output="$3" reader
  stty -F "$port" 38400 raw -echo -crtscts -hupcl cs8 -cstopb -parenb min 1 time 0
  timeout 8 cat "$port" > "$output" &
  reader=$!
  sleep 0.3
  printf '%s\r' "$command" > "$port"
  wait "$reader" 2>/dev/null || true
}

index=0
for port in "$@"; do
  identifier="${port#/dev/serial/by-id/}"
  [[ "$port" == /dev/serial/by-id/* && -n "$identifier" && "$identifier" != */* && "$identifier" != . && "$identifier" != .. && "$identifier" != *\\* && ! "$identifier" =~ [[:cntrl:]] ]] || {
    echo "Use a persistent /dev/serial/by-id adapter path: $port" >&2; exit 1;
  }
  [ -e "$port" ] || { echo "Adapter is missing: $port" >&2; exit 1; }
  index=$((index + 1))
  dir="$RESULT_DIR/adapter-${index}"
  mkdir -p "$dir"
  printf '%s\n' "$port" > "$dir/adapter-path.txt"
  hash="$(printf '%s' "$port" | sha1sum | cut -c1-12)"
  (
    exec 9>"$STATE_DIR/serial-${hash}.lock"
    flock -w 15 9 || { echo "Adapter remained locked: $port" >&2; exit 1; }
    if fuser "$(readlink -f "$port")" >/dev/null 2>&1; then
      echo "Adapter is open in another process: $port" >&2; exit 1
    fi
    query "$port" _who "$dir/who.txt"
    grep -Eqi 'I.?m[[:space:]]+primary[[:space:]]+and[[:space:]]+active' "$dir/who.txt" || {
      echo "No verified primary/active EMM response from $port; no further queries sent." >&2; exit 1;
    }
    query "$port" _ver "$dir/version.txt"
    query "$port" devils "$dir/command-list.txt"
  )
done

index=0
for generic in /sys/class/scsi_generic/sg*; do
  [ "$(cat "$generic/device/type" 2>/dev/null || true)" = 13 ] || continue
  index=$((index + 1))
  device="/dev/${generic##*/}"
  dir="$RESULT_DIR/enclosure-${index}"
  mkdir -p "$dir"
  readlink -f "$generic/device" > "$dir/scsi-path.txt"
  for page in 00 01 02 04 05 07 0a 0e 0f; do
    timeout 10 sg_ses -R -p "0x$page" "$device" > "$dir/ses-${page}.txt" 2>&1 || true
  done
  if command -v sg_inq >/dev/null 2>&1; then
    timeout 10 sg_inq "$device" > "$dir/inquiry.txt" 2>&1 || true
    for page in 00 80 83; do
      timeout 10 sg_inq -p "0x$page" "$device" > "$dir/vpd-${page}.txt" 2>&1 || true
    done
  fi
done

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/scripts/ipmi-supervisor.sh">
<INLINE>
<![CDATA[
#!/bin/bash
set -euo pipefail
RUNTIME=/usr/local/emhttp/plugins/md12xx.fancontrol
STATE=/var/run/md12xx.fancontrol
mkdir -p "$STATE"
exec 8>"$STATE/ipmi-supervisor.lock"
flock -n 8 || exit 1
child=""
finish() {
  trap - EXIT TERM INT
  if [ -n "$child" ]; then
    kill "$child" 2>/dev/null || true
    for ((i=0; i<25; i++)); do kill -0 "$child" 2>/dev/null || break; sleep 1; done
    if kill -0 "$child" 2>/dev/null; then echo 'IPMI controller did not stop; manual recovery required' >&2; exit 1; fi
    wait "$child" 2>/dev/null || true
  fi
  /usr/bin/php "$RUNTIME/include/ipmi-recover.php"
}
trap finish EXIT
trap 'exit 0' TERM INT
while true; do
  /usr/bin/php "$RUNTIME/include/ipmi-controller.php" 8>&- &
  child=$!
  echo "$child" > "$STATE/ipmi-controller.pid"
  while kill -0 "$child" 2>/dev/null; do
    sleep 5
    if [ -f /boot/config/plugins/md12xx.fancontrol/ipmi-owned.json ] && { [ ! -f "$STATE/ipmi-status.json" ] || [ $(( $(date +%s) - $(stat -c %Y "$STATE/ipmi-status.json") )) -gt 40 ]; }; then
      /usr/bin/php "$RUNTIME/include/ipmi-recover.php" || true
    fi
  done
  wait "$child" 2>/dev/null || true
  child=""
  /usr/bin/php "$RUNTIME/include/ipmi-recover.php" || true
  sleep 5
done

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/scripts/select-candidates.awk">
<INLINE>
<![CDATA[
# Select RPM-test candidates without treating stale host addresses as identity.
# First input: exact serial ELI-to-SES matches. Second input: discovered SES candidates.
BEGIN { FS = OFS = "\t" }
FILENAME == ARGV[1] {
    if (NF >= 2) { exact[$1 SUBSEP $2] = 1; exactCount++ }
    next
}
NF >= 2 {
    addresses[++count] = $1
    devices[count] = $2
}
END {
    # Multiple paths/matches cannot prove one physical pairing.
    if (exactCount > 1) exit 2
    for (i = 1; i <= count; i++) {
        if (exactCount == 1) {
            if (exact[addresses[i] SUBSEP devices[i]]) print addresses[i], devices[i]
        } else if (assignment == "automatic" || (address == "" && device == "")) {
            # A guarded unique RPM response must prove the automatic pairing.
            print addresses[i], devices[i]
        } else if ((address != "" && addresses[i] == address) || (address == "" && devices[i] == device)) {
            print addresses[i], devices[i]
        }
    }
}

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/scripts/stable-response.awk">
<INLINE>
<![CDATA[
BEGIN { FS="\t" }

NR == FNR {
  low[$1]=$3
  device[$1]=$2
  next
}

FNR == 1 || !($2 in low) { next }

{
  address=$2
  previous[address]=latest[address]
  latest[address]=$4+0
  samples[address]++
  delta=latest[address]-low[address]
  pct=(low[address]>0 ? delta/low[address]*100 : 0)
  if (delta >= 250 && pct >= 10) responded[address]=1
}

END {
  responseCount=0
  for (address in responded) responseCount++
  if (responseCount != 1) exit

  for (address in responded) {
    if (samples[address] < 2) exit
    previousDelta=previous[address]-low[address]
    previousPct=(low[address]>0 ? previousDelta/low[address]*100 : 0)
    latestDelta=latest[address]-low[address]
    latestPct=(low[address]>0 ? latestDelta/low[address]*100 : 0)
    difference=latest[address]-previous[address]
    if (difference < 0) difference=-difference
    tolerance=latest[address]*0.10
    if (tolerance < 250) tolerance=250
    if (previousDelta < 250 || previousPct < 10 || latestDelta < 250 || latestPct < 10 || difference > tolerance) exit

    stableRpm=int((previous[address]+latest[address])/2+0.5)
    stableDelta=stableRpm-low[address]
    stablePct=(low[address]>0 ? stableDelta/low[address]*100 : 0)
    printf "%s\t%s\t%d\t%d\t%d\t%.1f\n", address, device[address], low[address], stableRpm, stableDelta, stablePct
  }
}

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/scripts/start.sh">
<INLINE>
<![CDATA[
#!/bin/bash
set -e

RUNTIME_DIR="/usr/local/emhttp/plugins/md12xx.fancontrol"
STATE_DIR="/var/run/md12xx.fancontrol"
PID_FILE="$STATE_DIR/controller.pid"
SUPERVISOR_PID_FILE="$STATE_DIR/supervisor.pid"
DISCOVERY_PID_FILE="$STATE_DIR/discovery.pid"
mkdir -p "$STATE_DIR"

pid_matches() {
  local pid_file="$1"
  local marker="$2"
  local pid
  [ -s "$pid_file" ] || return 1
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ -r "/proc/$pid/cmdline" ] \
    && tr '\0' ' ' < "/proc/$pid/cmdline" | grep -Fq "$marker"
}

if ! pid_matches "$SUPERVISOR_PID_FILE" '/md12xx.fancontrol/scripts/controller-supervisor.sh'; then
  if pid_matches "$PID_FILE" '/md12xx.fancontrol/include/controller.php'; then
    ORPHAN_PID="$(cat "$PID_FILE")"
    kill "$ORPHAN_PID" 2>/dev/null || true
    for SECOND in 1 2 3 4 5; do
      kill -0 "$ORPHAN_PID" 2>/dev/null || break
      sleep 1
    done
    if kill -0 "$ORPHAN_PID" 2>/dev/null; then
      echo "The existing fan controller could not be stopped; refusing to start a second writer." >&2
      exit 1
    fi
  fi
  rm -f "$PID_FILE" "$SUPERVISOR_PID_FILE"
  nohup "$RUNTIME_DIR/scripts/controller-supervisor.sh" >/dev/null 2>&1 &
  echo "$!" > "$SUPERVISOR_PID_FILE"
fi

if ! pid_matches "$DISCOVERY_PID_FILE" '/md12xx.fancontrol/include/discovery.php'; then
  rm -f "$DISCOVERY_PID_FILE"
  nohup /usr/bin/php "$RUNTIME_DIR/include/discovery.php" >/dev/null 2>&1 &
  echo "$!" > "$DISCOVERY_PID_FILE"
fi

# The kernel drivers are supplied by Unraid; load the local device interface only on the supported host family.
if grep -qxE 'PowerEdge R730(xd)?' /sys/class/dmi/id/product_name 2>/dev/null; then
  /sbin/modprobe ipmi_devintf || true
  /sbin/modprobe ipmi_si || true
fi
if ! pid_matches "$STATE_DIR/ipmi-supervisor.pid" '/md12xx.fancontrol/scripts/ipmi-supervisor.sh'; then
  nohup "$RUNTIME_DIR/scripts/ipmi-supervisor.sh" >/dev/null 2>&1 &
  echo "$!" > "$STATE_DIR/ipmi-supervisor.pid"
fi

]]>
</INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged/scripts/stop.sh">
<INLINE>
<![CDATA[
#!/bin/bash
set -e

STATE_DIR="/var/run/md12xx.fancontrol"
PID_FILE="$STATE_DIR/controller.pid"
stop_pid() {
  local FILE="$1" PATTERN="$2" WAIT_COUNT="${3:-5}" PID
  if [ -s "$FILE" ]; then
    PID="$(cat "$FILE" 2>/dev/null || true)"
    if [ -n "$PID" ] && [ -r "/proc/$PID/cmdline" ] && tr '\0' ' ' < "/proc/$PID/cmdline" | grep -Fq "$PATTERN"; then
      kill "$PID" 2>/dev/null || true
      for ((SECOND=0; SECOND<WAIT_COUNT; SECOND++)); do kill -0 "$PID" 2>/dev/null || break; sleep 1; done
      if kill -0 "$PID" 2>/dev/null; then
        echo "Unable to stop $PATTERN safely; plugin files were not removed." >&2
        return 1
      fi
    fi
  fi
  rm -f "$FILE"
}
stop_pid "$STATE_DIR/ipmi-supervisor.pid" '/md12xx.fancontrol/scripts/ipmi-supervisor.sh' 40
stop_pid "$STATE_DIR/ipmi-controller.pid" '/md12xx.fancontrol/include/ipmi-controller.php' 25
if [ -f /boot/config/plugins/md12xx.fancontrol/ipmi-owned.json ]; then
  /usr/bin/php /usr/local/emhttp/plugins/md12xx.fancontrol/include/ipmi-recover.php || { echo 'Cannot restore iDRAC automatic cooling; refusing removal' >&2; exit 1; }
fi
stop_pid "$STATE_DIR/supervisor.pid" '/md12xx.fancontrol/scripts/controller-supervisor.sh' 20
stop_pid "$PID_FILE" '/md12xx.fancontrol/include/controller.php' 20
stop_pid "$STATE_DIR/discovery.pid" '/md12xx.fancontrol/include/discovery.php' 20
stop_pid "$STATE_DIR/diagnostics.pid" '/md12xx.fancontrol/scripts/diagnose.sh' 20
for JOB_PID_FILE in "$STATE_DIR"/commission-jobs/*/pid; do
  [ -e "$JOB_PID_FILE" ] || continue
  stop_pid "$JOB_PID_FILE" '/md12xx.fancontrol/scripts/commission-job.sh' 20
done
rm -f "$STATE_DIR/commissioning.active"
rm -f "$STATE_DIR"/serial-*.lock
rm -f "$STATE_DIR/diagnostics.lock"

]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
set -e
RUNTIME_DIR="/usr/local/emhttp/plugins/.md12xx.fancontrol.staged"
CONFIG_DIR="/boot/config/plugins/md12xx.fancontrol"
CONFIG_FILE="$CONFIG_DIR/config.json"

chmod 0644 "$RUNTIME_DIR/MD12xxFanControl.page" "$RUNTIME_DIR/icon.svg" "$RUNTIME_DIR/assets/css/settings.css" "$RUNTIME_DIR/assets/js/settings.js" "$RUNTIME_DIR/assets/icon.svg"
chmod 0644 "$RUNTIME_DIR/include/common.php" "$RUNTIME_DIR/include/controller.php" "$RUNTIME_DIR/include/discovery.php" "$RUNTIME_DIR/include/api.php" "$RUNTIME_DIR/include/download.php" "$RUNTIME_DIR/include/quiet.php" "$RUNTIME_DIR/include/safety.php" "$RUNTIME_DIR/include/commission-safety.php" "$RUNTIME_DIR/include/watchdog-health.php"
chmod 0644 "$RUNTIME_DIR/scripts/stable-response.awk" "$RUNTIME_DIR/scripts/select-candidates.awk"
chmod 0755 "$RUNTIME_DIR/scripts/start.sh" "$RUNTIME_DIR/scripts/stop.sh" "$RUNTIME_DIR/scripts/controller-supervisor.sh" "$RUNTIME_DIR/scripts/diagnose.sh" "$RUNTIME_DIR/scripts/interrogate-emm.sh" "$RUNTIME_DIR/scripts/commission.sh" "$RUNTIME_DIR/scripts/commission-job.sh"
chmod 0755 "$RUNTIME_DIR/scripts/ipmi-supervisor.sh" "$RUNTIME_DIR/bin/ipmitool.bin"
chmod 0644 "$RUNTIME_DIR/icon.png"
php -r '$image = getimagesize($argv[1]); if (!$image || $image[0] !== 256 || $image[1] !== 256 || $image[2] !== IMAGETYPE_PNG) exit(1);' "$RUNTIME_DIR/icon.png"
"$RUNTIME_DIR/bin/ipmitool.bin" -V >/dev/null
(cd "$RUNTIME_DIR/bin" && sha256sum -c SHA256SUMS >/dev/null)

for PHP_FILE in "$RUNTIME_DIR"/include/*.php; do php -l "$PHP_FILE" >/dev/null; done

for SHELL_FILE in "$RUNTIME_DIR"/scripts/*.sh; do bash -n "$SHELL_FILE"; done

# Staged validation must complete before stopping the installed processes.
STAGED_DIR="$RUNTIME_DIR"
RUNTIME_DIR="/usr/local/emhttp/plugins/md12xx.fancontrol"
PREVIOUS_DIR="/usr/local/emhttp/plugins/.md12xx.fancontrol.previous"
[ ! -L "$RUNTIME_DIR" ] && [ ! -L "$PREVIOUS_DIR" ] || exit 1
HAD_PREVIOUS=false
ACTIVATING=false
rollback_runtime() {
  local result=$?
  if [ "$result" -ne 0 ] && [ "$ACTIVATING" = true ]; then
    # A failed new start must be stopped before a previous writer is restored.
    if [ -x "$RUNTIME_DIR/scripts/stop.sh" ] && ! "$RUNTIME_DIR/scripts/stop.sh"; then
      echo "New runtime could not stop; previous runtime retained for supervised recovery." >&2
      return
    fi
    rm -rf -- "$RUNTIME_DIR"
    if $HAD_PREVIOUS; then
      mv -- "$PREVIOUS_DIR" "$RUNTIME_DIR"
      "$RUNTIME_DIR/scripts/start.sh" || true
    fi
    echo "Plugin activation failed; prior runtime restored when available." >&2
  fi
}
trap rollback_runtime EXIT
if [ -x "$RUNTIME_DIR/scripts/stop.sh" ]; then "$RUNTIME_DIR/scripts/stop.sh"; fi
# Keep a previous successful runtime until the next activation. Never touch config.
if [ -d "$RUNTIME_DIR" ]; then
  rm -rf -- "$PREVIOUS_DIR"
  mv -- "$RUNTIME_DIR" "$PREVIOUS_DIR"
  HAD_PREVIOUS=true
fi
ACTIVATING=true
mv -- "$STAGED_DIR" "$RUNTIME_DIR"

if [ ! -f "$CONFIG_FILE" ]; then
  cat > "$CONFIG_FILE" <<'MD12XX_CONFIG'
{
  "enabled": false,
  "mode": "auto",
  "manualSpeed": 20,
  "pollSeconds": 5,
  "reassertSeconds": 900,
  "sensorFailureSpeed": 50,
  "hysteresisC": 1,
  "discovery": {
    "autoProbeKnownFtdi": false,
    "intervalSeconds": 300,
    "responseSeconds": 3
  },
  "curve": [
    {"temperatureC": 0, "speed": 20},
    {"temperatureC": 35, "speed": 25},
    {"temperatureC": 45, "speed": 30},
    {"temperatureC": 50, "speed": 50}
  ],
  "legacyContainerNames": ["MD1200-Fan-Controller"],
  "shelves": []
}
MD12XX_CONFIG
fi

chmod 0644 "$CONFIG_FILE"
php -r '
  require $argv[1];
  $config = md12xx_read_config($argv[2]);
  $updated = md12xx_disable_active_discovery_after_setup($config);
  if (($config["discovery"]["autoProbeKnownFtdi"] ?? false) && !($updated["discovery"]["autoProbeKnownFtdi"] ?? false)) {
    md12xx_write_config($updated, $argv[2]);
    echo "Setup is already complete; active connection testing was turned off.\n";
  }
' "$RUNTIME_DIR/include/common.php" "$CONFIG_FILE"
mkdir -p /var/run/md12xx.fancontrol
"$RUNTIME_DIR/scripts/start.sh"
trap - EXIT
cat <<'MD12XX_BANNER'

              \   |   /
            ---\  |  /---
          -------(O)-------
            ---/  |  \---
              /   |   \

             MD12xx FAN CONTROL
      Storage is awesome. Quiet is power.

MD12XX_BANNER
echo "Version 0.5.0 installed. Configure it under Settings → Utilities."
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
set -e
RUNTIME_DIR="/usr/local/emhttp/plugins/md12xx.fancontrol"
CONFIG_DIR="/boot/config/plugins/md12xx.fancontrol"
if [ -x "$RUNTIME_DIR/scripts/stop.sh" ]; then
  "$RUNTIME_DIR/scripts/stop.sh"
fi
rm -rf "$RUNTIME_DIR" "/var/run/md12xx.fancontrol" "$CONFIG_DIR"
rm -rf "/usr/local/emhttp/plugins/.md12xx.fancontrol.staged" "/usr/local/emhttp/plugins/.md12xx.fancontrol.previous"
rm -f "/boot/config/plugins/md12xx.fancontrol.plg"
echo "MD12xx Fan Control removed. Configuration, commissioning results, and runtime state were deleted."
]]>
</INLINE>
</FILE>
</PLUGIN>
