<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name "md12xx.fancontrol">
  <!ENTITY author "TheIlluminate92">
  <!ENTITY version "@@VERSION@@">
  <!ENTITY launch "MD12xxFanControl">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="https://raw.githubusercontent.com/TheIlluminate92/waz-control/feature/standalone-md12xx-plugin/src/md12xx-fan-control/releases/md12xx.fancontrol.plg" min="6.12.0" support="https://github.com/TheIlluminate92/waz-control/issues" icon="cogs">
<CHANGES>
### 0.1.1
- Validates conservative discovery against mixed USB serial and SES hardware.
- Fixes the controller startup parser and adds a terminal installation banner.

### 0.1.0
- Initial standalone beta for Dell PowerVault MD1200 and MD1220 shelves.
- Adds multi-shelf configuration, conservative background discovery, Auto/Manual control, independent RPM telemetry, locking, and guarded commissioning.
- Optional serial verification is read-only, requires an MD12xx-shaped `_who` response, and is blocked while another fan controller is active.
</CHANGES>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
set -e
RUNTIME_DIR="/usr/local/emhttp/plugins/md12xx.fancontrol"
CONFIG_DIR="/boot/config/plugins/md12xx.fancontrol"

if [ -x "$RUNTIME_DIR/scripts/stop.sh" ]; then
  "$RUNTIME_DIR/scripts/stop.sh" || true
fi
rm -rf "$RUNTIME_DIR"
mkdir -p "$RUNTIME_DIR" "$CONFIG_DIR"
]]>
</INLINE>
</FILE>

@@FILES@@

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
set -e
RUNTIME_DIR="/usr/local/emhttp/plugins/md12xx.fancontrol"
CONFIG_DIR="/boot/config/plugins/md12xx.fancontrol"
CONFIG_FILE="$CONFIG_DIR/config.json"

chmod 0644 "$RUNTIME_DIR/MD12xxFanControl.page" "$RUNTIME_DIR/assets/css/settings.css" "$RUNTIME_DIR/assets/js/settings.js"
chmod 0644 "$RUNTIME_DIR/include/common.php" "$RUNTIME_DIR/include/controller.php" "$RUNTIME_DIR/include/discovery.php" "$RUNTIME_DIR/include/api.php"
chmod 0755 "$RUNTIME_DIR/scripts/start.sh" "$RUNTIME_DIR/scripts/stop.sh" "$RUNTIME_DIR/scripts/diagnose.sh" "$RUNTIME_DIR/scripts/commission.sh"

php -l "$RUNTIME_DIR/include/common.php" >/dev/null
php -l "$RUNTIME_DIR/include/controller.php" >/dev/null
php -l "$RUNTIME_DIR/include/discovery.php" >/dev/null
php -l "$RUNTIME_DIR/include/api.php" >/dev/null

if [ ! -f "$CONFIG_FILE" ]; then
  cat > "$CONFIG_FILE" <<'MD12XX_CONFIG'
{
  "enabled": false,
  "mode": "auto",
  "manualSpeed": 20,
  "pollSeconds": 30,
  "reassertSeconds": 900,
  "sensorFailureSpeed": 50,
  "hysteresisC": 1,
  "discovery": {
    "autoProbeKnownFtdi": false,
    "intervalSeconds": 300,
    "responseSeconds": 3
  },
  "curve": [
    {"temperatureC": 0, "speed": 20},
    {"temperatureC": 35, "speed": 25},
    {"temperatureC": 45, "speed": 30},
    {"temperatureC": 50, "speed": 50}
  ],
  "legacyContainerNames": ["MD1200-Fan-Controller"],
  "shelves": []
}
MD12XX_CONFIG
fi

chmod 0644 "$CONFIG_FILE"
mkdir -p /var/run/md12xx.fancontrol
"$RUNTIME_DIR/scripts/start.sh"
cat <<'MD12XX_BANNER'

              \   |   /
            ---\  |  /---
          -------(O)-------
            ---/  |  \---
              /   |   \

             MD12xx FAN CONTROL
      Storage is awesome. Quiet is power.

MD12XX_BANNER
echo "Version @@VERSION@@ installed. Configure it under Settings → Utilities."
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
RUNTIME_DIR="/usr/local/emhttp/plugins/md12xx.fancontrol"
if [ -x "$RUNTIME_DIR/scripts/stop.sh" ]; then
  "$RUNTIME_DIR/scripts/stop.sh" || true
fi
rm -rf "$RUNTIME_DIR" "/var/run/md12xx.fancontrol"
rm -f "/boot/config/plugins/md12xx.fancontrol.plg"
echo "MD12xx Fan Control removed. Persistent settings were retained in /boot/config/plugins/md12xx.fancontrol."
]]>
</INLINE>
</FILE>
</PLUGIN>
